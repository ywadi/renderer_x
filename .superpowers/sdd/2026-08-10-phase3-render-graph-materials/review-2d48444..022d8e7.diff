index 0000000..342c80f
--- /dev/null
+++ b/shaders/material/material.slang
@@ -0,0 +1,37 @@
+// rx_material's engine-defined Slang interface every material module
+// conforms to [spec Phase 3 design, D6]. Follows the Shader Components
+// lineage (He et al. 2017) and its production evolution in Slang --
+// Falcor's material system is the direct shipping precedent for
+// "material = Slang module implementing an engine interface"
+// (.superpowers/sdd/2026-08-10-phase3-render-graph-materials/
+// research-abi-materials.md S2.2).
+//
+// `public` on every declaration here is load-bearing, not decorative: this
+// file is a Slang MODULE (imported via `import material;` from both
+// forward_entry.slang and every material module), and Slang's access
+// control defaults an unmodified top-level declaration to `internal`
+// (module-local) visibility -- an importing module cannot see IMaterialShader
+// or MaterialVertex at all without the explicit `public` on each
+// declaration (and, for MaterialVertex, on each field: a struct's default
+// member visibility only inherits its enclosing type's own visibility
+// starting at Slang language version 2026, and this file does not opt into
+// `#language slang 2026`, so fields need their own explicit `public` too)
+// [Slang user guide, "Modules and Access Control" -- Access Control].
+
+public struct MaterialVertex {
+    public float3 worldPos;
+    public float3 normal;
+    public float2 uv;
+}
+
+// Every material module (e.g. a material's own .slang file, loaded via
+// MaterialSystem::loadMaterial()) declares a struct conforming to this
+// interface plus a `ParameterBlock<TParams> gParams` global holding its
+// bound parameters [D6, D8] -- see forward_entry.slang's own header
+// comment for the exact link-time-specialization contract a conforming
+// module must follow, and shaders/material/tests-equivalent
+// src/rx_material/tests/data/test_unlit.slang for a worked minimal
+// example.
+public interface IMaterialShader {
+    float4 evaluate(MaterialVertex v);
+}
diff --git a/shaders/multipass/lit.frag.slang b/shaders/multipass/lit.frag.slang
new file mode 100644
index 0000000..a7947e1
--- /dev/null
+++ b/shaders/multipass/lit.frag.slang
@@ -0,0 +1,83 @@
+// Sample 05_multipass: forward-pass fragment shader.
+//
+// Concatenated AFTER lit.vert.slang at compile time (see that file's own
+// header comment) -- every global this file references (gPush, gTextures,
+// gSamplers, gTransforms, ObjectTransform, PushConstants) is declared
+// there, not here.
+//
+// SHADOW SAMPLING [coordinator ambiguity resolution]: manual single-tap
+// depth comparison against the shadow map, sampled through the SAME
+// bindless Texture2D+SamplerState convention every other sample in this
+// codebase uses (no VK_COMPARE_OP-enabled VkSampler) -- `gSamplers[
+// shadowSamplerIndex]` is a plain NEAREST/CLAMP_TO_EDGE sampler (see
+// main.cpp's createScene()), and this shader does the depth >
+// storedDepth + bias comparison itself, in ordinary float arithmetic, no
+// different from sampling any other single-channel texture. A small
+// constant bias (kShadowBias) pushes the compared depth slightly toward
+// the light to absorb shadow-mapping self-shadowing/acne at grazing
+// angles -- a fixed constant is enough for this sample's fixed, modest
+// light elevation; a production shadow system would typically scale it by
+// slope/texel size instead.
+static const float kShadowBias = 0.0025;
+
+float sampleShadowFactor(float4 lightSpacePosition, uint shadowTextureIndex, uint shadowSamplerIndex)
+{
+    // Orthographic light projection (see main.cpp's makeLightViewProj) --
+    // w is always 1.0, but dividing through anyway costs nothing and keeps
+    // this correct if a future edit ever made the light projection
+    // perspective instead.
+    float3 ndc = lightSpacePosition.xyz / lightSpacePosition.w;
+
+    // NDC xy in [-1, 1] -> shadow-map UV in [0, 1]; Vulkan's own NDC is
+    // already Y-down (see main.cpp's makeLightViewProj comment on the
+    // proj[1][1] flip it applies for exactly this reason), so no extra Y
+    // flip is needed here -- ndc.y already increases downward, matching
+    // texture-space V.
+    float2 shadowUV = ndc.xy * 0.5 + 0.5;
+    float fragmentDepth = ndc.z;
+
+    // Outside the light's own ortho frustum (can happen in --present mode,
+    // whose animated light azimuth is not guaranteed to keep every point
+    // of this fixed scene inside frustum bounds sized for the headless
+    // pose) -- CLAMP_TO_EDGE addressing (main.cpp's sampler) already makes
+    // an out-of-[0,1] sample well-defined (it just re-samples the nearest
+    // edge texel) rather than needing a manual bounds check here; treating
+    // it as unconditionally lit rather than trusting an edge-clamped depth
+    // comparison is the simpler, still-correct choice for a sample whose
+    // whole point is the shadow near the fixed headless-camera probes, not
+    // exhaustive frustum-edge behavior.
+    if (shadowUV.x < 0.0 || shadowUV.x > 1.0 || shadowUV.y < 0.0 || shadowUV.y > 1.0) {
+        return 1.0;
+    }
+
+    float storedDepth = gTextures[shadowTextureIndex].Sample(gSamplers[shadowSamplerIndex], shadowUV).r;
+    return (fragmentDepth - kShadowBias > storedDepth) ? 0.0 : 1.0;
+}
+
+[shader("fragment")]
+float4 fsMain(VSOut input) : SV_Target
+{
+    // Re-reads this object's own row -- see lit.vert.slang's header
+    // comment for why `albedo`/`lightDirWorld` live here rather than in
+    // gPush; gTransforms[0] is the same one bindless storage buffer both
+    // shader stages of this pass share.
+    ObjectTransform xf = gTransforms[0][gPush.transformIndex];
+
+    float3 normal = normalize(input.worldNormal);
+    // xf.lightDirWorld: the direction the light travels (from the light
+    // toward the scene) -- the Lambert term wants the direction FROM the
+    // surface TOWARD the light, i.e. the negation.
+    float3 toLight = -normalize(xf.lightDirWorld.xyz);
+    float lambert = max(dot(normal, toLight), 0.0);
+
+    float shadow = sampleShadowFactor(input.lightSpacePosition, gPush.shadowTextureIndex, gPush.shadowSamplerIndex);
+
+    // A small constant ambient term keeps a fully-shadowed surface visibly
+    // non-black (distinguishable from the clear color) without needing a
+    // second light or an ambient-occlusion pass this sample has no other
+    // use for.
+    const float kAmbient = 0.08;
+    float lit = kAmbient + (1.0 - kAmbient) * lambert * shadow;
+
+    return float4(xf.albedo.rgb * lit, 1.0);
+}
diff --git a/shaders/multipass/lit.vert.slang b/shaders/multipass/lit.vert.slang
new file mode 100644
index 0000000..f6c4ae8
--- /dev/null
+++ b/shaders/multipass/lit.vert.slang
@@ -0,0 +1,105 @@
+// Sample 05_multipass: forward-pass vertex shader.
+//
+// COMPILATION NOTE -- read before editing either file: rx::shader::Compiler
+// compiles exactly one module (one source string) per call, and
+// rx::shader::reflect() needs every entry point of a pass in ONE linked
+// program to produce a single, correctly-merged descriptor-set/push-
+// constant layout (the same reason 02_hotreload/03_bindless_mesh/
+// 04_streaming each embed their vertex+fragment source together as one
+// string). samples/05_multipass/main.cpp's compileAndReflect() reproduces
+// that same shape for THIS pass's on-disk files by reading and
+// concatenating them (scene_types.slang first, this file second,
+// lit.frag.slang third) into one Slang translation unit before compiling
+// -- so every `[[vk::binding(...)]]`/`[[vk::push_constant]]` global
+// declared below, and `ObjectTransform` (scene_types.slang), are visible
+// to lit.frag.slang's fsMain too, exactly as if they had all been written
+// in one file. Do not re-declare any of these globals in lit.frag.slang.
+//
+// SHADOW SAMPLING: manual single-tap depth comparison in lit.frag.slang, no
+// VkSampler compare mode [coordinator ambiguity resolution] -- this file's
+// job is only to compute and pass through `lightSpacePosition`, an
+// unmodified light-clip-space position lit.frag.slang projects itself.
+//
+// OBJECT TRANSFORMS: one bindless storage buffer holds BOTH matrices this
+// sample ever needs per object -- `.mvp` (camera clip-space, used here) and
+// `.lightMvp` (light clip-space, passed through as a varying for
+// lit.frag.slang's shadow lookup) -- addressed via a push-constant
+// `transformIndex`, exactly samples/03_bindless_mesh's bindless-storage-
+// buffer-plus-push-constant-index pattern [coordinator ambiguity
+// resolution]. shadow.vert.slang reads the identical row layout for its own
+// `.lightMvp` half.
+//
+// NO PER-OBJECT ROTATION -- see samples/05_multipass/main.cpp's header
+// comment for why this sample's scene objects only ever translate, never
+// rotate: under a translation-only model matrix, a direction vector
+// (a vertex normal) transforms identically in object space and world
+// space, so this shader passes `input.normal` straight through with no
+// normal-matrix multiply at all. Reintroducing per-object rotation without
+// also reintroducing a normal-matrix transform here would silently break
+// lit.frag.slang's Lambert term.
+// `ObjectTransform` itself now lives in scene_types.slang (concatenated
+// ahead of this file at compile time -- see the COMPILATION NOTE above
+// and that file's own header comment for the full "why not import/
+// __include" rationale) [fix round 1: this struct used to be declared
+// here directly, and separately again in shadow.vert.slang, with only a
+// comment guarding the two copies from drifting -- they drifted; see
+// scene_types.slang's header for the postmortem].
+//
+// `albedo`/`lightDirWorld` live in the SAME bindless row as the two
+// matrices (as float4 -- the 4th component unused padding, sidestepping
+// any float3-packing ambiguity) rather than in push constants: EMPIRICALLY
+// VERIFIED against the shipped Slang build (reflect()'s own reported
+// push-constant range size, checked directly during this sample's
+// development) that a push-constant block's real size is NOT rounded up
+// to any fixed multiple the way samples/04_streaming's own struct
+// (which contained a float4x4) suggested -- a lone `uint` reflects at
+// exactly 4 bytes, not 16. Rather than reverse-engineer Slang's exact
+// float3/vec-alignment rule inside a push-constant block from scratch,
+// this sample keeps every push-constant field a plain scalar `uint`
+// (empirically confirmed to pack with zero padding, consecutive 4-byte
+// fields) and puts every vector value in the storage buffer instead, whose
+// StructuredBuffer element layout this codebase already has a proven-
+// correct convention for (samples/03_bindless_mesh/04_streaming's own
+// mat4 rows). `lightDirWorld` is the same value on every object's row
+// each frame (a per-pass, not per-object, constant) -- redundant across
+// rows, but simpler than a second one-row bindless buffer just for it.
+struct PushConstants {
+    uint transformIndex;
+    uint shadowTextureIndex;
+    uint shadowSamplerIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 0)]]
+Texture2D gTextures[];
+
+[[vk::binding(1, 0)]]
+SamplerState gSamplers[];
+
+[[vk::binding(2, 0)]]
+StructuredBuffer<ObjectTransform> gTransforms[];
+
+struct VSIn {
+    float3 position : POSITION;
+    float3 normal : NORMAL;
+};
+
+struct VSOut {
+    float4 clipPosition : SV_Position;
+    float3 worldNormal : NORMAL;
+    float4 lightSpacePosition : TEXCOORD0;
+};
+
+[shader("vertex")]
+VSOut vsMain(VSIn input)
+{
+    ObjectTransform xf = gTransforms[0][gPush.transformIndex];
+
+    VSOut o;
+    o.clipPosition = mul(xf.mvp, float4(input.position, 1.0));
+    o.worldNormal = input.normal;
+    o.lightSpacePosition = mul(xf.lightMvp, float4(input.position, 1.0));
+    return o;
+}
diff --git a/shaders/multipass/scene_types.slang b/shaders/multipass/scene_types.slang
new file mode 100644
index 0000000..6cba5e9
--- /dev/null
+++ b/shaders/multipass/scene_types.slang
@@ -0,0 +1,75 @@
+// Sample 05_multipass: shared scene-data types.
+//
+// SINGLE SOURCE OF TRUTH for `ObjectTransform` -- the bindless storage-
+// buffer row layout `shadow.vert.slang` and `lit.vert.slang`/
+// `lit.frag.slang` both read via `gTransforms[0][gPush.transformIndex]`.
+// Declared exactly ONCE, here, specifically to close a real bug class
+// found during this sample's own development [fix round 1]: `shadow.vert.
+// slang` used to declare its OWN separate copy of this struct (it is
+// compiled as its own Slang module -- see below for why -- never
+// concatenated with the lit files), and that copy silently drifted out of
+// sync with `lit.vert.slang`'s when the latter grew two more fields
+// (`albedo`, `lightDirWorld`). Every index-0 row (the floor) still read
+// correctly regardless of which struct's stride was used (both agree at
+// byte offset 0), which is exactly why the drift went unnoticed until a
+// probe at a NON-zero row (the cube) read a garbled mix of two adjacent
+// rows. Two hand-written copies with only a comment enforcing agreement
+// is not a real guard against that recurring -- this file, and every
+// consumer's mechanical inclusion of it (see below), is.
+//
+// WHY THIS FILE IS TEXTUALLY CONCATENATED, NOT `import`ed OR `__include`d
+// -- read before reaching for either Slang mechanism on this file:
+//   - `import scene_types;` (Slang's own module system -- the mechanism
+//     shaders/material/forward_entry.slang uses for `import material;`,
+//     and the one this task's own coordinator review named as preferred)
+//     needs the compiling `slang::ISession` to have a search path
+//     covering this file's real on-disk directory
+//     (`slang::SessionDesc::searchPaths`) -- exactly what
+//     `src/rx_material/material_system.cpp`'s own session setup adds
+//     (`RX_MATERIAL_SHADER_DIR`), and exactly what `rx::shader::Compiler`
+//     (`src/rx_shader/src/compiler.cpp`) does NOT: its `slang::SessionDesc`
+//     is default-constructed with zero search paths, by design --
+//     `material_system.cpp`'s own header comment on this exact point:
+//     "Compiler's own sessions never set [search paths] (it has no
+//     multi-file import to resolve)". samples/05_multipass/main.cpp
+//     compiles every pass through THIS Compiler (not the raw Slang API
+//     rx_material uses directly), so a real `import` here would need
+//     either extending `rx::shader::Compiler` to accept search paths
+//     (explicitly out of scope for this task per the coordinator's fix-
+//     round instructions) or reimplementing this sample's entire compile-
+//     +-reflect pipeline against the raw Slang API just to get one struct
+//     shared -- disproportionate to the actual problem.
+//   - `__include "scene_types.slang"` (Slang's textual-inclusion
+//     directive, the coordinator's own stated fallback) reduces to
+//     exactly the same requirement: with no session search path
+//     configured, resolving even `__include`'s path needs either a
+//     search path (same gap as `import`) or a literal, runtime-resolved
+//     absolute path baked into the compiled source text at the point of
+//     the directive -- which on Windows means a backslash-bearing path
+//     string threaded through a Slang string-literal escape sequence with
+//     no existing test coverage of that behavior in this codebase.
+//   - This sample's `main.cpp` already established (before this fix
+//     round, for pairing each pass's vertex+fragment source into one
+//     Slang translation unit -- see lit.vert.slang's own "COMPILATION
+//     NOTE") the exact mechanism this problem actually needs: read this
+//     file's real, `SDL_GetBasePath()`-resolved bytes from disk and
+//     concatenate them into the combined source string BEFORE any of it
+//     reaches Slang at all -- Slang itself never sees a directive, never
+//     needs a search path, and there is no path-string-escaping surface
+//     to get wrong on any platform. `compileAndReflect()`'s callers now
+//     list this file first for both the shadow and lit passes (see
+//     buildShadowPipeline()/buildLitPipeline()) -- textually and
+//     functionally equivalent to `__include`, implemented with a
+//     mechanism this file already had and already ships correctly.
+//
+// `albedo`/`lightDirWorld` are float4 (unused 4th component) rather than
+// float3 -- sidesteps any float3-in-a-StructuredBuffer packing ambiguity;
+// see the (former) home of this struct, lit.vert.slang, for the sibling
+// finding on push-constant scalar packing this same investigation
+// produced.
+struct ObjectTransform {
+    float4x4 mvp;
+    float4x4 lightMvp;
+    float4 albedo;
+    float4 lightDirWorld;
+};
diff --git a/shaders/multipass/shadow.vert.slang b/shaders/multipass/shadow.vert.slang
new file mode 100644
index 0000000..d8cd86d
--- /dev/null
+++ b/shaders/multipass/shadow.vert.slang
@@ -0,0 +1,51 @@
+// Sample 05_multipass: shadow pass vertex shader.
+//
+// Depth-only pass -- there is deliberately no shadow.frag.slang at all:
+// with no color attachments and rasterizerDiscardEnable = VK_FALSE, Vulkan
+// needs no fragment shader stage to write depth at all (the depth test/
+// write consumes SV_Position.z's interpolated value); samples/05_multipass/
+// main.cpp's shadow pipeline has exactly one shader stage (VERTEX) because
+// of this, not by omission.
+//
+// Reads the SAME bindless object-transform storage buffer
+// lit.vert.slang/lit.frag.slang read (row layout must match byte-for-byte)
+// via rx::rhi::BindlessTable's fixed binding 2 (kStorageBufferBinding),
+// but only ever consumes `.lightMvp` here: this pass renders the scene
+// from the light's own point of view, so a caster's CAMERA-space MVP is
+// irrelevant to it. `transformIndex` (a push constant, uniform across the
+// whole draw call) selects which object's row to read -- never wrapped in
+// NonUniformResourceIndex() [spec Fixed decision #6, matching every other
+// sample's push-constant-indexed bindless read].
+//
+// `ObjectTransform` is concatenated ahead of this file at compile time
+// from scene_types.slang -- see samples/05_multipass/main.cpp's
+// buildShadowPipeline() and scene_types.slang's own header comment for
+// why (and for the postmortem of the real bug this fixes: this file used
+// to declare its OWN separate copy of this struct, since it is compiled
+// as its own Slang module -- never concatenated with the lit files -- and
+// that copy silently drifted out of sync with lit.vert.slang's when the
+// latter grew two more fields). [fix round 1]
+struct PushConstants {
+    uint transformIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(2, 0)]]
+StructuredBuffer<ObjectTransform> gTransforms[];
+
+struct VSIn {
+    float3 position : POSITION;
+};
+
+[shader("vertex")]
+float4 vsMain(VSIn input) : SV_Position
+{
+    // gTransforms[0]: this sample registers exactly ONE bindless storage
+    // buffer (the shared, double-buffered-by-row transform table), exactly
+    // like samples/03_bindless_mesh's own gTransforms[0] -- a compile-time-
+    // constant descriptor-array index, uniform by construction.
+    float4x4 lightMvp = gTransforms[0][gPush.transformIndex].lightMvp;
+    return mul(lightMvp, float4(input.position, 1.0));
+}
diff --git a/shaders/multipass/tonemap.frag.slang b/shaders/multipass/tonemap.frag.slang
new file mode 100644
index 0000000..4c84e82
--- /dev/null
+++ b/shaders/multipass/tonemap.frag.slang
@@ -0,0 +1,18 @@
+// Sample 05_multipass: tonemap-pass fragment shader.
+//
+// Concatenated AFTER tonemap.vert.slang at compile time -- gPush/gTextures/
+// gSamplers are declared there (see that file's own header comment).
+//
+// Plain Reinhard (c / (1 + c), per channel) [task brief] -- the resulting
+// [0,1) value is written straight to the swapchain's own UNORM/SRGB
+// attachment; linear -> sRGB encoding (when the swapchain format carries
+// an _SRGB suffix) is handled by the GPU's fixed-function attachment write
+// path, exactly like every other sample in this codebase relies on for its
+// own color output, not by this shader.
+[shader("fragment")]
+float4 fsMain(VSOut input) : SV_Target
+{
+    float3 hdr = gTextures[gPush.hdrTextureIndex].Sample(gSamplers[gPush.hdrSamplerIndex], input.uv).rgb;
+    float3 mapped = hdr / (1.0 + hdr);
+    return float4(mapped, 1.0);
+}
diff --git a/shaders/multipass/tonemap.vert.slang b/shaders/multipass/tonemap.vert.slang
new file mode 100644
index 0000000..7d581ad
--- /dev/null
+++ b/shaders/multipass/tonemap.vert.slang
@@ -0,0 +1,44 @@
+// Sample 05_multipass: tonemap-pass vertex shader.
+//
+// COMPILATION NOTE: concatenated BEFORE tonemap.frag.slang at compile time
+// (see lit.vert.slang's identical header comment for the full rationale) --
+// every global declared below is visible to tonemap.frag.slang's fsMain.
+//
+// Classic "one oversized triangle covers the whole clip-space square" trick
+// (no vertex buffer, SV_VertexID-driven) -- the exact same idiom
+// src/rx_graph/tests/test_execute_gpu.cpp's "invert" shader and this
+// project's other fullscreen passes already use.
+struct PushConstants {
+    uint hdrTextureIndex;
+    uint hdrSamplerIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 0)]]
+Texture2D gTextures[];
+
+[[vk::binding(1, 0)]]
+SamplerState gSamplers[];
+
+struct VSOut {
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+[shader("vertex")]
+VSOut vsMain(uint vertexID : SV_VertexID)
+{
+    float2 positions[3] = float2[3](
+        float2(-1.0, -1.0),
+        float2(3.0, -1.0),
+        float2(-1.0, 3.0)
+    );
+    float2 p = positions[vertexID];
+
+    VSOut o;
+    o.position = float4(p, 0.0, 1.0);
+    o.uv = p * 0.5 + 0.5;
+    return o;
+}
diff --git a/src/rx_graph/CMakeLists.txt b/src/rx_graph/CMakeLists.txt
new file mode 100644
index 0000000..1569317
--- /dev/null
+++ b/src/rx_graph/CMakeLists.txt
@@ -0,0 +1,31 @@
+# rx_graph: the device-free front half of Phase 3's render graph -- pass
+# declarations, name-based dependency resolution, culling, topological
+# ordering, and physical-resource lifetime analysis (Task 1 brief), plus
+# compile-time sync2 barrier derivation (Task 2 brief, barriers.cpp/h).
+# render_graph.cpp/barriers.cpp depend on nothing but Vulkan-Headers
+# (VkFormat/Vk*Flags2/Vk*Bit types only -- no loader, no volk, see
+# render_graph.h's header-hygiene comment) and rx_core (RX_LOG_ERROR before
+# every validation throw in render_graph.cpp, matching rx_shader's/
+# rx_rhi_vk's own error-reporting convention).
+#
+# Task 3 adds rx_rhi_vk to this library's link line: executor.cpp/
+# transient_pool.cpp are the first things in rx_graph that touch a real
+# VkDevice (Texture2D/Buffer/Allocator/DeletionQueue realize the graph's
+# physical resources; rx::rhi::Device supplies the physical device/
+# instance/queue Executor::create() needs). This is additive, not a
+# retraction of Tasks 1-2's device-free design: render_graph.cpp/
+# barriers.cpp are unchanged in that respect, and rx_graph's PUBLIC headers
+# (render_graph.h/pass.h/resources.h/barriers.h/executor.h) still carry no
+# volk and no rx_rhi_vk type -- see executor.h's and transient_pool.h's own
+# header-hygiene comments for exactly where the device-touching boundary
+# now sits.
+add_library(rx_graph STATIC
+    render_graph.cpp
+    barriers.cpp
+    executor.cpp
+    transient_pool.cpp
+)
+target_include_directories(rx_graph PUBLIC include)
+target_link_libraries(rx_graph PUBLIC Vulkan::Headers rx_core rx_rhi_vk)
+
+add_subdirectory(tests)
diff --git a/src/rx_graph/barriers.cpp b/src/rx_graph/barriers.cpp
new file mode 100644
index 0000000..e22c227
--- /dev/null
+++ b/src/rx_graph/barriers.cpp
@@ -0,0 +1,256 @@
+#include <rx_graph/barriers.h>
+#include <rx_graph/render_graph.h>
+
+#include <algorithm>
+#include <span>
+#include <utility>
+#include <vector>
+
+// Task 2's barrier build: per-resource invalidate/flush state machine
+// (ported from Granite's RenderGraph::build_physical_barriers /
+// physical_pass_handle_invalidate_barrier / need_invalidate /
+// physical_pass_handle_flush_barrier -- see barriers.h's own comment on
+// detail::ResourceBarrierState/detail::applyAccess for the exact
+// re-derivation and what didn't carry over) applied once per physical
+// resource, in CompiledGraph::executionOrder() order, over the
+// resource-access data Task 1's compile() already resolved.
+//
+// What Granite's model has that this port deliberately still does not:
+// its `PipelineEvent` also carries `wait_graphics_semaphore`/
+// `wait_compute_semaphore` and `locked_invalidation`, used to satisfy a
+// dependency via a queue semaphore instead of a same-queue pipeline
+// barrier, and to guard against double-processing one barrier. rx_graph
+// has exactly one queue and calls detail::applyAccess() exactly once per
+// resource per execution-order position (never re-entrantly), so neither
+// concern exists yet -- Task 3's executor, if it ever needs cross-queue
+// hand-off, is where that would be re-added, not here.
+namespace rx::graph {
+
+namespace detail {
+
+namespace {
+
+// Access bits any declared ResourceAccess in this project can carry that
+// represent a write [Task 1's Pass::resolveAccess table]. A write's
+// pendingFlushAccess only needs to remember these -- not e.g.
+// DEPTH_STENCIL_ATTACHMENT_READ_BIT, which a depth-stencil output also
+// carries but which never needs flushing (nothing was made dirty by
+// reading it) [Task 2 brief: "WAW: barrier with srcAccess = prior write
+// access"].
+constexpr VkAccessFlags2 kWriteAccessMask = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                                             VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+                                             VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT;
+
+bool isWriteAccess(VkAccessFlags2 access) {
+    return (access & kWriteAccessMask) != 0;
+}
+
+// Granite's `Util::for_each_bit64` over a stage mask, re-expressed as a
+// plain loop rather than ported bit-trick for bit-trick's sake -- called
+// at most a handful of times per declared access, never a hot path.
+template <typename Fn>
+void forEachStageBit(VkPipelineStageFlags2 stages, Fn&& fn) {
+    for (uint32_t bit = 0; bit < 64; ++bit) {
+        if ((stages & (VkPipelineStageFlags2{1} << bit)) != 0) {
+            fn(bit);
+        }
+    }
+}
+
+// Granite's `need_invalidate()` (render_graph.cpp ~L1748-1756): true if
+// *any* of the requested stage bits does not yet have every requested
+// access bit recorded as invalidated (visible) for that specific stage.
+// Checking per-stage-bit, not against one aggregate, is exactly the fix
+// this task's Critical finding required: a reader in stage S1 being
+// invalidated must never be read back as "stage S2 is invalidated too."
+bool coveredByInvalidated(const ResourceBarrierState& state, VkPipelineStageFlags2 stages, VkAccessFlags2 access) {
+    bool covered = true;
+    forEachStageBit(stages, [&](uint32_t bit) {
+        if ((state.invalidatedInStage[bit] & access) != access) {
+            covered = false;
+        }
+    });
+    return covered;
+}
+
+}  // namespace
+
+std::optional<BarrierTransition> applyAccess(ResourceBarrierState& state, bool isBuffer, VkPipelineStageFlags2 stages,
+                                              VkAccessFlags2 access, VkImageLayout layout) {
+    const bool write = isWriteAccess(access);
+    const bool layoutDiffers = !isBuffer && layout != state.currentLayout;
+    // Granite's need_sync = layout_change || (to_flush_access != 0) ||
+    // need_invalidate(...), applied uniformly to both reads and writes in
+    // physical_pass_handle_invalidate_barrier(). The write-specific
+    // "(write && everAccessed)" disjunct below stands in for Granite's own
+    // gate on whether to actually *emit* a barrier once need_sync is true
+    // (`need_pipeline_barrier = event.pipeline_barrier_src_stages != 0`,
+    // i.e. "only if some prior write exists to sync against") -- Task 1's
+    // topology guarantees the first access to any resource is always a
+    // write, so `everAccessed` and "a prior write exists" coincide here,
+    // and folding need_invalidate's coverage check into the write branch
+    // too would (wrongly) demand a barrier for a resource's very first
+    // write, which has nothing to be invalidated against yet.
+    const bool needBarrier =
+        layoutDiffers || (write && state.everAccessed) || (!write && !coveredByInvalidated(state, stages, access));
+
+    std::optional<BarrierTransition> transition;
+    if (needBarrier) {
+        BarrierTransition t;
+        if (write) {
+            if (state.hasPendingFlush) {
+                // WAW: the prior write is still unflushed -- make it
+                // available before this write's own incoming dependency.
+                t.srcStage = state.lastWriteStages;
+                t.srcAccess = state.pendingFlushAccess;
+            } else if (state.everAccessed) {
+                // WAR: nothing is unflushed, but every reader since the
+                // last write must still finish -- srcStage is their union
+                // [Task 2 fix round 1, Critical finding: not Granite's own
+                // `pipeline_barrier_src_stages` here, which names only the
+                // *write's* stage and would not wait on any reader at all;
+                // see detail::ResourceBarrierState::invalidatedStagesUnion's
+                // comment].
+                t.srcStage = state.invalidatedStagesUnion;
+                t.srcAccess = VK_ACCESS_2_NONE;
+            } else {
+                // First use ever.
+                t.srcStage = VK_PIPELINE_STAGE_2_NONE;
+                t.srcAccess = VK_ACCESS_2_NONE;
+            }
+        } else {
+            // Read: chains off the persisted last-write source (Granite's
+            // `pipeline_barrier_src_stages`), which survives a resolved
+            // flush -- so a later read in a stage the first resolving read
+            // never covered still gets a correct barrier instead of
+            // silently falling through with none.
+            t.srcStage = state.lastWriteStages;
+            t.srcAccess = state.hasPendingFlush ? state.pendingFlushAccess : VK_ACCESS_2_NONE;
+        }
+        t.dstStage = stages;
+        t.dstAccess = access;
+        if (!isBuffer) {
+            t.oldLayout = state.currentLayout;
+            t.newLayout = layout;
+        }
+        transition = t;
+    }
+
+    if (!isBuffer) {
+        state.currentLayout = layout;
+    }
+
+    if (write) {
+        // Granite: a fresh write means every previously-invalidated stage
+        // is stale (it granted visibility to the *old* contents), and
+        // `pipeline_barrier_src_stages`/`to_flush_access` both reset to
+        // this write's own (stage, access) [physical_pass_handle_flush_
+        // barrier()].
+        state.invalidatedInStage.fill(0);
+        state.invalidatedStagesUnion = 0;
+        state.lastWriteStages = stages;
+        state.pendingFlushAccess = access & kWriteAccessMask;
+        state.hasPendingFlush = true;
+    } else if (needBarrier) {
+        // Granite: `event.to_flush_access = 0` unconditionally after any
+        // invalidate call, and `invalidated_in_stage[bit] |= barrier.access`
+        // only for the bits this specific barrier's stages cover.
+        state.hasPendingFlush = false;
+        state.pendingFlushAccess = 0;
+        forEachStageBit(stages, [&](uint32_t bit) { state.invalidatedInStage[bit] |= access; });
+        state.invalidatedStagesUnion |= stages;
+    }
+    // A read that needed no barrier changes nothing: its own stage was
+    // already fully covered, so there is nothing new to record.
+
+    state.everAccessed = true;
+    return transition;
+}
+
+}  // namespace detail
+
+namespace {
+
+// One pass's declared accesses, merged per physical resource. Almost
+// always a 1:1 pass with a single ResourceAccess per resource; the merge
+// only does real work for Task 2's ambiguity resolution "a resource both
+// read and written by the same pass (e.g. depth output also declared
+// sampled -- invalid combination) -- ... derive barriers from the union
+// access at that pass; do not add new validation in this task": stages
+// and access simply union, and a write's layout wins over a read's when a
+// pass declares both for the same resource (the write is what actually
+// establishes the pass's real image layout; Task 1 does not reject this
+// combination, so this is "don't crash on it", not new validation).
+struct CombinedAccess {
+    VkPipelineStageFlags2 stages = 0;
+    VkAccessFlags2 access = 0;
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+};
+
+std::vector<std::pair<uint32_t, CombinedAccess>> combineByResource(std::span<const ResourceAccess> accesses) {
+    std::vector<std::pair<uint32_t, CombinedAccess>> combined;
+    for (const ResourceAccess& access : accesses) {
+        auto it = std::find_if(combined.begin(), combined.end(),
+                                [&](const auto& entry) { return entry.first == access.physicalIndex; });
+        if (it == combined.end()) {
+            combined.push_back({access.physicalIndex, CombinedAccess{access.stages, access.access, access.layout}});
+            continue;
+        }
+        it->second.stages |= access.stages;
+        it->second.access |= access.access;
+        if (detail::isWriteAccess(access.access) || it->second.layout == VK_IMAGE_LAYOUT_UNDEFINED) {
+            it->second.layout = access.layout;
+        }
+    }
+    return combined;
+}
+
+}  // namespace
+
+std::vector<PassBarriers> buildBarriers(const CompiledGraph& graph, PassBarriers& outFinalBarriers) {
+    const std::span<const PhysicalResource> resources = graph.resources();
+    std::vector<detail::ResourceBarrierState> state(resources.size());  // per-frame: starts empty [Task 2 brief D4]
+
+    const std::span<const uint32_t> order = graph.executionOrder();
+    std::vector<PassBarriers> result(order.size());
+
+    for (size_t pos = 0; pos < order.size(); ++pos) {
+        PassBarriers& passBarriers = result[pos];
+        for (const auto& [physicalIndex, combined] : combineByResource(graph.passAccesses(order[pos]))) {
+            const PhysicalResource& resource = resources[physicalIndex];
+            std::optional<detail::BarrierTransition> transition = detail::applyAccess(
+                state[physicalIndex], resource.isBuffer, combined.stages, combined.access, combined.layout);
+            if (!transition) {
+                continue;
+            }
+            if (resource.isBuffer) {
+                passBarriers.bufferBarriers.push_back(BufferBarrier{
+                    physicalIndex, transition->srcStage, transition->srcAccess, transition->dstStage, transition->dstAccess});
+            } else {
+                passBarriers.imageBarriers.push_back(ImageBarrier{physicalIndex, transition->srcStage, transition->srcAccess,
+                                                                    transition->dstStage, transition->dstAccess,
+                                                                    transition->oldLayout, transition->newLayout});
+            }
+        }
+    }
+
+    // ---- finalBarriers(): the backbuffer's transition to PRESENT_SRC_KHR,
+    // src = its last write's (stage, access) [Task 2 brief ambiguity
+    // resolution]. That is exactly the resource's pendingFlush at the end
+    // of the walk: nothing reads the backbuffer after its final writer
+    // runs, so nothing ever resolves/clears it first.
+    for (uint32_t i = 0; i < resources.size(); ++i) {
+        if (!resources[i].isBackbuffer) {
+            continue;
+        }
+        const detail::ResourceBarrierState& s = state[i];
+        outFinalBarriers.imageBarriers.push_back(ImageBarrier{i, s.lastWriteStages, s.pendingFlushAccess,
+                                                                VK_PIPELINE_STAGE_2_NONE, VK_ACCESS_2_NONE, s.currentLayout,
+                                                                VK_IMAGE_LAYOUT_PRESENT_SRC_KHR});
+        break;
+    }
+
+    return result;
+}
+
+}  // namespace rx::graph
