+// --- IRxMaterialSystem ------------------------------------------------
+class MaterialSystemImpl final : public RxUnknownBase<MaterialSystemImpl, IRxMaterialSystem> {
+public:
+    explicit MaterialSystemImpl(rx::material::MaterialSystem* internalSystem) : internal_(internalSystem) {}
+
