@@ -0,0 +1,37 @@
+// Third test fixture, added for Task 6's IRxMaterialInstance::setTexture()
+// contract test (test_api_factory.cpp): test_unlit.slang/test_solid.slang
+// only declare a float4 field, so neither can exercise setTexture()'s
+// success path or its IRxTexture addRef()/release() lifetime handling.
+// This module declares a single `uint albedoIndex` field -- this
+// engine's own D8 convention for a bindless texture parameter (a plain
+// data index into the bindless table, never a resource-typed field
+// inside TParams itself -- see material_system.cpp's own comment on
+// gParams). Same shape as test_unlit.slang otherwise (see that file's
+// own header comment for the full per-part rationale, not repeated
+// here).
+import material;
+
+struct TexturedParams {
+    uint albedoIndex;
+};
+
+[[vk::binding(0, 1)]]
+ParameterBlock<TexturedParams> gParams;
+
+struct Textured : IMaterialShader {
+    float4 evaluate(MaterialVertex v) {
+        // Same dead-code-elimination-avoidance rationale as
+        // test_unlit.slang's own Unlit::evaluate() -- every
+        // MaterialVertex field genuinely (if negligibly) read, plus a
+        // non-constant-foldable read of `gParams.albedoIndex` so this
+        // field is not itself optimized away as unused.
+        float4 color = float4(0.0, 0.0, 0.0, 1.0);
+        color.x += v.worldPos.x * 1e-4;
+        color.y += v.normal.y * 1e-4;
+        color.z += v.uv.x * 1e-4;
+        color.w += float(gParams.albedoIndex) * 1e-4;
+        return color;
+    }
+};
+
+export struct MaterialImpl : IMaterialShader = Textured;
diff --git a/src/rx_material/tests/data/test_unlit.slang b/src/rx_material/tests/data/test_unlit.slang
new file mode 100644
index 0000000..6cf7388
--- /dev/null
+++ b/src/rx_material/tests/data/test_unlit.slang
@@ -0,0 +1,70 @@
+// Minimal material module for test_material_system.cpp's "load-reflect"
+// case: flat, unlit color from a single bound parameter. Every material
+// module follows this same shape [D6, D8]:
+//   1. `import material;` for IMaterialShader/MaterialVertex.
+//   2. Its own parameter struct + a `ParameterBlock<TParams> gParams`
+//      global, EXPLICITLY bound to (binding 0, set 1) via `[[vk::binding]]`
+//      -- see the comment on `gParams` below for why this is explicit
+//      rather than left to Slang's own automatic assignment.
+//   3. A struct conforming to IMaterialShader, reading `gParams` in its
+//      `evaluate()` body.
+//   4. The link-time type alias (`export struct MaterialImpl ... = ...;`)
+//      forward_entry.slang's `extern struct MaterialImpl : IMaterialShader;`
+//      resolves against at composite/link time -- see that file's header
+//      comment for the full mechanism and citation.
+import material;
+
+struct UnlitParams {
+    float4 tint;
+};
+
+// EXPLICIT (binding, set) rather than automatic assignment: MaterialSystem
+// (material_system.cpp) requires descriptor set 1 for every material's
+// parameter block (set 0 is the external bindless set) and enforces it by
+// reading the real set number back out of reflection and rejecting a
+// mismatch -- see material_system.cpp's own comment on
+// `SlangParameterCategory::SubElementRegisterSpace` for the verified detail
+// that matters here: a top-level `ParameterBlock<T>` global reports THAT
+// category (not `DescriptorTableSlot`, which rx_shader::reflect() itself
+// only handles), and for that category
+// `VariableLayoutReflection::getBindingIndex()` -- not getBindingSpace() --
+// is the call that returns the real descriptor set number (verified
+// directly against this project's shipped Slang v2026.14.1 build via
+// spirv-dis on the real emitted SPIR-V at three different explicit
+// `[[vk::binding]]` set values; see task-5-report.md for the probe). This
+// attribute is what actually PUTS `gParams` at set 1 in the real SPIR-V --
+// reflection only ever reads that fact back to validate it, never invents
+// or corrects it.
+[[vk::binding(0, 1)]]
+ParameterBlock<UnlitParams> gParams;
+
+struct Unlit : IMaterialShader {
+    float4 evaluate(MaterialVertex v) {
+        // Genuinely (if negligibly) reads every MaterialVertex field --
+        // deliberate, not filler: forward_entry.slang's vertexMain writes
+        // worldPos/normal/uv unconditionally (it has no way to know ahead
+        // of time which fields a given material's evaluate() will touch),
+        // and Slang's SPIR-V backend optimizes each entry point's I/O
+        // interface independently -- a material that never reads one of
+        // these fields gets that exact interpolant dead-code-eliminated
+        // from ITS OWN (fragment-side) input interface, while the shared
+        // vertex stage still writes it, producing a real (if harmless --
+        // Vulkan's spec explicitly permits it) vertex-output-not-consumed
+        // mismatch that this project's validation gate (--validate; every
+        // test in this suite asserts zero validation messages) flags at
+        // WARNING severity. Verified directly: dropping this and simply
+        // returning `gParams.tint` reproduces exactly that warning against
+        // this project's real GPU test fixture; this formula (each `* 1e-4`
+        // term is a real, non-constant-foldable dependency on runtime
+        // interpolated data, so the compiler cannot prove it away) does
+        // not. The `1e-4` terms are numerically negligible for any normal
+        // input -- this material's actual color is still tint-driven.
+        float4 tint = gParams.tint;
+        tint.x += v.worldPos.x * 1e-4;
+        tint.y += v.normal.y * 1e-4;
+        tint.z += v.uv.x * 1e-4;
+        return tint;
+    }
+};
+
+export struct MaterialImpl : IMaterialShader = Unlit;
diff --git a/src/rx_material/tests/doctest_main.cpp b/src/rx_material/tests/doctest_main.cpp
new file mode 100644
index 0000000..033b25e
--- /dev/null
+++ b/src/rx_material/tests/doctest_main.cpp
@@ -0,0 +1,52 @@
+// DOCTEST_CONFIG_IMPLEMENT (not _WITH_MAIN): main() below needs to run code
+// before any TEST_CASE executes, so it constructs and drives the
+// doctest::Context itself instead of using doctest's generated main() --
+// the exact same warm-up pattern src/rx_rhi_vk/tests/doctest_main.cpp and
+// src/rx_graph/tests/doctest_main_gpu.cpp both already establish (copied
+// here, not shared, matching those two files' own precedent): every
+// test_material_system.cpp case builds a real rx::rhi::Device (via
+// rx::platform::Window), exposing it to the same vk-bootstrap process-wide
+// instance-function-pointer-caching hazard documented on
+// rx::rhi::Context::create()'s own WARNING (rx_rhi_vk/context.h) -- the
+// pinned vk-bootstrap commit caches instance-level Vulkan function
+// pointers process-wide from whichever vkb::Instance is built FIRST,
+// forever, with no reset. Warming the cache with the BROADEST instance
+// this binary will ever need (real window extensions when available,
+// enableValidation=true unconditionally) before any TEST_CASE runs makes
+// that hazard's precondition impossible to hit, regardless of test order.
+#define DOCTEST_CONFIG_IMPLEMENT
+#include <doctest/doctest.h>
+#include <rx_platform/window.h>
+#include <rx_rhi_vk/context.h>
+
+#include <vector>
+
+namespace {
+
+void warmUpVkBootstrapInstanceFunctionCache() {
+    std::vector<const char*> extensions;
+    auto window = rx::platform::Window::create("rx_material_gpu_tests_warmup", 64, 64, /*visible=*/false);
+    if (window.has_value()) {
+        extensions = window->requiredVulkanInstanceExtensions();
+    }
+    // enableValidation=true here is not incidental -- see
+    // rx_rhi_vk/tests/doctest_main.cpp's identical warm-up for the full
+    // rationale (the same process-wide vk-bootstrap cache also covers
+    // fp_vkCreateDebugUtilsMessengerEXT, only non-null when the FIRST
+    // instance built in this process actually requested validation).
+    rx::rhi::Context::create(extensions, /*enableValidation=*/true);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    warmUpVkBootstrapInstanceFunctionCache();
+
+    doctest::Context context;
+    context.applyCommandLine(argc, argv);
+    int res = context.run();
+    if (context.shouldExit()) {
+        return res;
+    }
+    return res;
+}
