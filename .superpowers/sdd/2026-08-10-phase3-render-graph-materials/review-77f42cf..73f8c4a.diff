+            impl.pool.buffer(resolvedRes.poolIndex).lastFrameFinalStages = stage;
+            impl.pool.touchBuffer(resolvedRes.poolIndex, impl.frameCounter);
+        } else {
+            impl.pool.image(resolvedRes.poolIndex).lastFrameFinalStages = stage;
