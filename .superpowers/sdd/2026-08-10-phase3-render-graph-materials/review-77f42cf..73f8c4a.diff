+        }
+
+        PassContext ctx;
+        ctx.cmd = cmd;
+        ctx.renderArea = renderArea;
+        ctx.executor_ = this;
+        pass.invokeExecute(ctx);
+
+        if (isGraphicsPass) {
+            vkCmdEndRendering(cmd);
+        }
