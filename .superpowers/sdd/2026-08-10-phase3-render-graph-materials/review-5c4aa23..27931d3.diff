diff --git a/shaders/multipass/lit.frag.slang b/shaders/multipass/lit.frag.slang
new file mode 100644
index 0000000..a7947e1
--- /dev/null
+++ b/shaders/multipass/lit.frag.slang
@@ -0,0 +1,83 @@
+// Sample 05_multipass: forward-pass fragment shader.
+//
+// Concatenated AFTER lit.vert.slang at compile time (see that file's own
+// header comment) -- every global this file references (gPush, gTextures,
+// gSamplers, gTransforms, ObjectTransform, PushConstants) is declared
+// there, not here.
+//
+// SHADOW SAMPLING [coordinator ambiguity resolution]: manual single-tap
+// depth comparison against the shadow map, sampled through the SAME
+// bindless Texture2D+SamplerState convention every other sample in this
+// codebase uses (no VK_COMPARE_OP-enabled VkSampler) -- `gSamplers[
+// shadowSamplerIndex]` is a plain NEAREST/CLAMP_TO_EDGE sampler (see
+// main.cpp's createScene()), and this shader does the depth >
+// storedDepth + bias comparison itself, in ordinary float arithmetic, no
+// different from sampling any other single-channel texture. A small
+// constant bias (kShadowBias) pushes the compared depth slightly toward
+// the light to absorb shadow-mapping self-shadowing/acne at grazing
+// angles -- a fixed constant is enough for this sample's fixed, modest
+// light elevation; a production shadow system would typically scale it by
+// slope/texel size instead.
+static const float kShadowBias = 0.0025;
+
+float sampleShadowFactor(float4 lightSpacePosition, uint shadowTextureIndex, uint shadowSamplerIndex)
+{
+    // Orthographic light projection (see main.cpp's makeLightViewProj) --
+    // w is always 1.0, but dividing through anyway costs nothing and keeps
+    // this correct if a future edit ever made the light projection
+    // perspective instead.
+    float3 ndc = lightSpacePosition.xyz / lightSpacePosition.w;
+
+    // NDC xy in [-1, 1] -> shadow-map UV in [0, 1]; Vulkan's own NDC is
+    // already Y-down (see main.cpp's makeLightViewProj comment on the
+    // proj[1][1] flip it applies for exactly this reason), so no extra Y
+    // flip is needed here -- ndc.y already increases downward, matching
+    // texture-space V.
+    float2 shadowUV = ndc.xy * 0.5 + 0.5;
+    float fragmentDepth = ndc.z;
+
+    // Outside the light's own ortho frustum (can happen in --present mode,
+    // whose animated light azimuth is not guaranteed to keep every point
+    // of this fixed scene inside frustum bounds sized for the headless
+    // pose) -- CLAMP_TO_EDGE addressing (main.cpp's sampler) already makes
+    // an out-of-[0,1] sample well-defined (it just re-samples the nearest
+    // edge texel) rather than needing a manual bounds check here; treating
+    // it as unconditionally lit rather than trusting an edge-clamped depth
+    // comparison is the simpler, still-correct choice for a sample whose
+    // whole point is the shadow near the fixed headless-camera probes, not
+    // exhaustive frustum-edge behavior.
+    if (shadowUV.x < 0.0 || shadowUV.x > 1.0 || shadowUV.y < 0.0 || shadowUV.y > 1.0) {
+        return 1.0;
+    }
+
+    float storedDepth = gTextures[shadowTextureIndex].Sample(gSamplers[shadowSamplerIndex], shadowUV).r;
+    return (fragmentDepth - kShadowBias > storedDepth) ? 0.0 : 1.0;
+}
+
+[shader("fragment")]
+float4 fsMain(VSOut input) : SV_Target
+{
+    // Re-reads this object's own row -- see lit.vert.slang's header
+    // comment for why `albedo`/`lightDirWorld` live here rather than in
+    // gPush; gTransforms[0] is the same one bindless storage buffer both
+    // shader stages of this pass share.
+    ObjectTransform xf = gTransforms[0][gPush.transformIndex];
+
+    float3 normal = normalize(input.worldNormal);
+    // xf.lightDirWorld: the direction the light travels (from the light
+    // toward the scene) -- the Lambert term wants the direction FROM the
+    // surface TOWARD the light, i.e. the negation.
+    float3 toLight = -normalize(xf.lightDirWorld.xyz);
+    float lambert = max(dot(normal, toLight), 0.0);
+
+    float shadow = sampleShadowFactor(input.lightSpacePosition, gPush.shadowTextureIndex, gPush.shadowSamplerIndex);
+
+    // A small constant ambient term keeps a fully-shadowed surface visibly
+    // non-black (distinguishable from the clear color) without needing a
+    // second light or an ambient-occlusion pass this sample has no other
+    // use for.
+    const float kAmbient = 0.08;
+    float lit = kAmbient + (1.0 - kAmbient) * lambert * shadow;
+
+    return float4(xf.albedo.rgb * lit, 1.0);
+}
diff --git a/shaders/multipass/lit.vert.slang b/shaders/multipass/lit.vert.slang
new file mode 100644
index 0000000..bd0f996
--- /dev/null
+++ b/shaders/multipass/lit.vert.slang
@@ -0,0 +1,103 @@
+// Sample 05_multipass: forward-pass vertex shader.
+//
+// COMPILATION NOTE -- read before editing either file: rx::shader::Compiler
+// compiles exactly one module (one source string) per call, and
+// rx::shader::reflect() needs every entry point of a pass in ONE linked
+// program to produce a single, correctly-merged descriptor-set/push-
+// constant layout (the same reason 02_hotreload/03_bindless_mesh/
+// 04_streaming each embed their vertex+fragment source together as one
+// string). samples/05_multipass/main.cpp's loadPassModule() reproduces that
+// same shape for THIS pass's two on-disk files by reading and concatenating
+// them (this file first, lit.frag.slang second) into one Slang translation
+// unit before compiling -- so every `[[vk::binding(...)]]`/
+// `[[vk::push_constant]]` global declared below is visible to lit.frag.slang's
+// fsMain too, exactly as if they had been written in one file. Do not
+// re-declare any of these globals in lit.frag.slang.
+//
+// SHADOW SAMPLING: manual single-tap depth comparison in lit.frag.slang, no
+// VkSampler compare mode [coordinator ambiguity resolution] -- this file's
+// job is only to compute and pass through `lightSpacePosition`, an
+// unmodified light-clip-space position lit.frag.slang projects itself.
+//
+// OBJECT TRANSFORMS: one bindless storage buffer holds BOTH matrices this
+// sample ever needs per object -- `.mvp` (camera clip-space, used here) and
+// `.lightMvp` (light clip-space, passed through as a varying for
+// lit.frag.slang's shadow lookup) -- addressed via a push-constant
+// `transformIndex`, exactly samples/03_bindless_mesh's bindless-storage-
+// buffer-plus-push-constant-index pattern [coordinator ambiguity
+// resolution]. shadow.vert.slang reads the identical row layout for its own
+// `.lightMvp` half.
+//
+// NO PER-OBJECT ROTATION -- see samples/05_multipass/main.cpp's header
+// comment for why this sample's scene objects only ever translate, never
+// rotate: under a translation-only model matrix, a direction vector
+// (a vertex normal) transforms identically in object space and world
+// space, so this shader passes `input.normal` straight through with no
+// normal-matrix multiply at all. Reintroducing per-object rotation without
+// also reintroducing a normal-matrix transform here would silently break
+// lit.frag.slang's Lambert term.
+// `albedo`/`lightDirWorld` live in the SAME bindless row as the two
+// matrices (as float4 -- the 4th component unused padding, sidestepping
+// any float3-packing ambiguity) rather than in push constants: EMPIRICALLY
+// VERIFIED against the shipped Slang build (reflect()'s own reported
+// push-constant range size, checked directly during this sample's
+// development) that a push-constant block's real size is NOT rounded up
+// to any fixed multiple the way samples/04_streaming's own struct
+// (which contained a float4x4) suggested -- a lone `uint` reflects at
+// exactly 4 bytes, not 16. Rather than reverse-engineer Slang's exact
+// float3/vec-alignment rule inside a push-constant block from scratch,
+// this sample keeps every push-constant field a plain scalar `uint`
+// (empirically confirmed to pack with zero padding, consecutive 4-byte
+// fields) and puts every vector value in the storage buffer instead, whose
+// StructuredBuffer element layout this codebase already has a proven-
+// correct convention for (samples/03_bindless_mesh/04_streaming's own
+// mat4 rows). `lightDirWorld` is the same value on every object's row
+// each frame (a per-pass, not per-object, constant) -- redundant across
+// rows, but simpler than a second one-row bindless buffer just for it.
+struct ObjectTransform {
+    float4x4 mvp;
+    float4x4 lightMvp;
+    float4 albedo;
+    float4 lightDirWorld;
+};
+
+struct PushConstants {
+    uint transformIndex;
+    uint shadowTextureIndex;
+    uint shadowSamplerIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 0)]]
+Texture2D gTextures[];
+
+[[vk::binding(1, 0)]]
+SamplerState gSamplers[];
+
+[[vk::binding(2, 0)]]
+StructuredBuffer<ObjectTransform> gTransforms[];
+
+struct VSIn {
+    float3 position : POSITION;
+    float3 normal : NORMAL;
+};
+
+struct VSOut {
+    float4 clipPosition : SV_Position;
+    float3 worldNormal : NORMAL;
+    float4 lightSpacePosition : TEXCOORD0;
+};
+
+[shader("vertex")]
+VSOut vsMain(VSIn input)
+{
+    ObjectTransform xf = gTransforms[0][gPush.transformIndex];
+
+    VSOut o;
+    o.clipPosition = mul(xf.mvp, float4(input.position, 1.0));
+    o.worldNormal = input.normal;
+    o.lightSpacePosition = mul(xf.lightMvp, float4(input.position, 1.0));
+    return o;
+}
diff --git a/shaders/multipass/shadow.vert.slang b/shaders/multipass/shadow.vert.slang
new file mode 100644
index 0000000..8771b52
--- /dev/null
+++ b/shaders/multipass/shadow.vert.slang
@@ -0,0 +1,67 @@
+// Sample 05_multipass: shadow pass vertex shader.
+//
+// Depth-only pass -- there is deliberately no shadow.frag.slang at all:
+// with no color attachments and rasterizerDiscardEnable = VK_FALSE, Vulkan
+// needs no fragment shader stage to write depth at all (the depth test/
+// write consumes SV_Position.z's interpolated value); samples/05_multipass/
+// main.cpp's shadow pipeline has exactly one shader stage (VERTEX) because
+// of this, not by omission.
+//
+// Reads the SAME bindless object-transform storage buffer
+// lit.vert.slang/lit.frag.slang read (row layout must match byte-for-byte
+// -- see lit.vert.slang's own header comment) via
+// rx::rhi::BindlessTable's fixed binding 2 (kStorageBufferBinding), but
+// only ever consumes `.lightMvp` here: this pass renders the scene from
+// the light's own point of view, so a caster's CAMERA-space MVP is
+// irrelevant to it. `transformIndex` (a push constant, uniform across the
+// whole draw call) selects which object's row to read -- never wrapped in
+// NonUniformResourceIndex() [spec Fixed decision #6, matching every other
+// sample's push-constant-indexed bindless read].
+// MUST stay byte-for-byte identical (same fields, same order, same size)
+// to lit.vert.slang's OWN ObjectTransform struct -- this is a SEPARATE
+// Slang compilation module (see this file's header comment: no
+// lit.vert.slang concatenation here), so Slang computes THIS struct's own
+// stride/size independently when indexing `gTransforms[0][transformIndex]`.
+// A real, found-during-development bug this comment now documents: an
+// earlier revision of this file only had the first two fields (mvp,
+// lightMvp) after lit.vert.slang's own struct grew two more (albedo,
+// lightDirWorld) -- every index-0 read (the floor, whose row happens to
+// start at byte 0 under EITHER stride) still worked, but every index 1+
+// read (cube, sphere) silently computed the wrong byte offset into the
+// SAME real buffer (128-byte stride here vs. the real 160-byte stride the
+// C++ writer and lit.vert.slang both use), reading a garbled mix of the
+// previous row's tail and the current row's head -- a plausible-looking
+// but WRONG matrix, not a crash or an obviously-garbage value. This is
+// exactly the class of bug this sample's own headless gate (shadow-vs-lit
+// probe brightness) is designed to catch.
+struct ObjectTransform {
+    float4x4 mvp;
+    float4x4 lightMvp;
+    float4 albedo;
+    float4 lightDirWorld;
+};
+
+struct PushConstants {
+    uint transformIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(2, 0)]]
+StructuredBuffer<ObjectTransform> gTransforms[];
+
+struct VSIn {
+    float3 position : POSITION;
+};
+
+[shader("vertex")]
+float4 vsMain(VSIn input) : SV_Position
+{
+    // gTransforms[0]: this sample registers exactly ONE bindless storage
+    // buffer (the shared, double-buffered-by-row transform table), exactly
+    // like samples/03_bindless_mesh's own gTransforms[0] -- a compile-time-
+    // constant descriptor-array index, uniform by construction.
+    float4x4 lightMvp = gTransforms[0][gPush.transformIndex].lightMvp;
+    return mul(lightMvp, float4(input.position, 1.0));
+}
diff --git a/shaders/multipass/tonemap.frag.slang b/shaders/multipass/tonemap.frag.slang
new file mode 100644
index 0000000..4c84e82
--- /dev/null
+++ b/shaders/multipass/tonemap.frag.slang
@@ -0,0 +1,18 @@
+// Sample 05_multipass: tonemap-pass fragment shader.
+//
+// Concatenated AFTER tonemap.vert.slang at compile time -- gPush/gTextures/
+// gSamplers are declared there (see that file's own header comment).
+//
+// Plain Reinhard (c / (1 + c), per channel) [task brief] -- the resulting
+// [0,1) value is written straight to the swapchain's own UNORM/SRGB
+// attachment; linear -> sRGB encoding (when the swapchain format carries
+// an _SRGB suffix) is handled by the GPU's fixed-function attachment write
+// path, exactly like every other sample in this codebase relies on for its
+// own color output, not by this shader.
+[shader("fragment")]
+float4 fsMain(VSOut input) : SV_Target
+{
+    float3 hdr = gTextures[gPush.hdrTextureIndex].Sample(gSamplers[gPush.hdrSamplerIndex], input.uv).rgb;
+    float3 mapped = hdr / (1.0 + hdr);
+    return float4(mapped, 1.0);
+}
diff --git a/shaders/multipass/tonemap.vert.slang b/shaders/multipass/tonemap.vert.slang
new file mode 100644
index 0000000..7d581ad
--- /dev/null
+++ b/shaders/multipass/tonemap.vert.slang
@@ -0,0 +1,44 @@
+// Sample 05_multipass: tonemap-pass vertex shader.
+//
+// COMPILATION NOTE: concatenated BEFORE tonemap.frag.slang at compile time
+// (see lit.vert.slang's identical header comment for the full rationale) --
+// every global declared below is visible to tonemap.frag.slang's fsMain.
+//
+// Classic "one oversized triangle covers the whole clip-space square" trick
+// (no vertex buffer, SV_VertexID-driven) -- the exact same idiom
+// src/rx_graph/tests/test_execute_gpu.cpp's "invert" shader and this
+// project's other fullscreen passes already use.
+struct PushConstants {
+    uint hdrTextureIndex;
+    uint hdrSamplerIndex;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 0)]]
+Texture2D gTextures[];
+
+[[vk::binding(1, 0)]]
+SamplerState gSamplers[];
+
+struct VSOut {
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+[shader("vertex")]
+VSOut vsMain(uint vertexID : SV_VertexID)
+{
+    float2 positions[3] = float2[3](
+        float2(-1.0, -1.0),
+        float2(3.0, -1.0),
+        float2(-1.0, 3.0)
+    );
+    float2 p = positions[vertexID];
+
+    VSOut o;
+    o.position = float4(p, 0.0, 1.0);
+    o.uv = p * 0.5 + 0.5;
+    return o;
+}
