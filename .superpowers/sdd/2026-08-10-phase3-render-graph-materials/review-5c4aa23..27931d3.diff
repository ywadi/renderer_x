+// PUBLIC rx_core dependency, transitively available here; the
+// GLM_FORCE_DEPTH_ZERO_TO_ONE define must precede GLM's first include in
+// this TU.
+#define GLM_FORCE_DEPTH_ZERO_TO_ONE
