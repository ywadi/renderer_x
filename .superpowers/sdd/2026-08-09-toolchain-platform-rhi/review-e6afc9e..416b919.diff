@@ -0,0 +1,5 @@
+#!/usr/bin/env bash
+set -euo pipefail
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+exec "$REPO_ROOT/toolchain/zig/zig" cc -target x86_64-linux-gnu -Wno-nullability-completeness "$@"
