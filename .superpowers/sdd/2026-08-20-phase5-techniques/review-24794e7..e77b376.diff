+std::optional<Args> parseArgs(int argc, char** argv) {
+    Args args;
+    for (int i = 1; i < argc; ++i) {
+        const std::string_view arg = argv[i];
+        if (arg == "--model" && i + 1 < argc) {
+            args.model = argv[++i];
+        } else if (arg == "--validate") {
+            args.validate = true;
+        } else if (arg == "--perturb-roughness") {
+            args.perturbRoughness = true;
+        } else if (arg == "--dump" && i + 1 < argc) {
+            args.dumpPath = argv[++i];
+        } else {
+            RX_LOG_ERROR("rx_conformance_render: unrecognized argument '{}'", arg);
+            return std::nullopt;
+        }
+    }
+    if (args.model.empty()) {
+        RX_LOG_ERROR("rx_conformance_render: --model <Name> is required");
+        return std::nullopt;
+    }
+    return args;
+}
