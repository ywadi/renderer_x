     // decodeStbImageHdr()'s own header comment for the silent-tonemap gap
     // this ordering closes.
     if (stbi_is_hdr_from_memory(reinterpret_cast<const stbi_uc*>(bytes.data()), static_cast<int>(bytes.size())) != 0) {
