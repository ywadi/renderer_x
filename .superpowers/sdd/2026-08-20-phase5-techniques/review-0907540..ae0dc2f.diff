+std::optional<Fixture> makeFixture(const char* title) {
+    auto window = rx::platform::Window::create(title, 64, 64, /*visible=*/false);
+    if (!window.has_value()) {
+        MESSAGE("no display backend available, skipping rx_cluster shading GPU test");
+        return std::nullopt;
