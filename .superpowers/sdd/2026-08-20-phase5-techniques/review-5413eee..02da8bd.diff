diff --git a/shaders/cluster/froxel_common.slang b/shaders/cluster/froxel_common.slang
new file mode 100644
index 0000000..5c466ae
--- /dev/null
+++ b/shaders/cluster/froxel_common.slang
@@ -0,0 +1,190 @@
+// shaders/cluster/froxel_common.slang -- Phase 5 Stage 2 Task 14 [#50]:
+// the GPU (Slang) mirror of rx_scene/froxel_grid.h's device-free camera-
+// frustum froxel grid math. Every formula below is the BIT-FOR-BIT twin of
+// its C++ counterpart in src/rx_scene/froxel_grid.cpp (which itself cites
+// google/filament v1.75.0, commit 0e58877c09afb1aacd09ff640f74d2adcd2a7e80,
+// Froxelizer.{h,cpp} + Intersections.h per-function -- see that file's own
+// citations; not repeated here to avoid drift between two copies of the
+// same citation text). Kept in sync MANUALLY -- this toolchain has no
+// shared C++/Slang codegen -- which is exactly why rx_scene/tests/
+// froxel_grid_test.cpp's device-free oracle and this file's own GPU
+// membership tests (rx_cluster's test suite) cross-check the SAME grid
+// parameters against BOTH derivations and assert byte/value equality, not
+// mere resemblance [matrix row 1's own acceptance text: "the SAME formula
+// ... matches the fragment-shader-side ... formula bit-for-bit in
+// derivation, not just close"].
+//
+// COORDINATE CONVENTION: view space, camera looks down -Z (see froxel_grid.h's
+// own top comment) -- identical here.
+
+// GPU mirror of rx::scene::froxel::FroxelGridParams (froxel_grid.h). Field
+// order/types chosen for a natural, unambiguous [[vk::push_constant]]
+// layout (all 4-byte scalars, no vec3 padding ambiguity).
+public struct FroxelGridParamsGpu {
+    public uint countX;
+    public uint countY;
+    public uint countZ;
+    public uint totalLightCount;
+    public float tanHalfFovY;
+    public float aspectRatio;
+    public float zLightNear;
+    public float zLightFar;
+    public float linearizer;
+    public float invLinearizer;
+    public uint maxLightsPerFroxel;
+    public uint maxTotalLightIndices;
+};
+
+public uint froxelCountTotal(FroxelGridParamsGpu grid) {
+    return grid.countX * grid.countY * grid.countZ;
+}
+
+// Port of rx::scene::froxel::froxelCoords() [froxel_grid.cpp].
+public uint3 froxelCoordsFromIndex(uint index, FroxelGridParamsGpu grid) {
+    uint plane = grid.countX * grid.countY;
+    uint z = plane != 0 ? index / plane : 0;
+    uint rem = plane != 0 ? index % plane : 0;
+    uint y = grid.countX != 0 ? rem / grid.countX : 0;
+    uint x = grid.countX != 0 ? rem % grid.countX : 0;
+    return uint3(x, y, z);
+}
+
+// Port of rx::scene::froxel::sliceZDistance() [froxel_grid.cpp -- see that
+// function's own derivation comment for why i==1 resolves to EXACTLY
+// zLightNear and i==countZ to EXACTLY zLightFar].
+public float sliceZDistance(uint i, FroxelGridParamsGpu grid) {
+    if (i == 0) {
+        return 0.0;
+    }
+    float n = float(grid.countZ);
+    float fi = float(i);
+    return grid.zLightFar * exp2((fi - n) * grid.linearizer);
+}
+
+// Port of rx::scene::froxel::findSliceZ() [froxel_grid.cpp, itself a
+// bit-for-bit port of Froxelizer::findSliceZ(), Froxelizer.cpp:580-598].
+// Not used by this task's own compute kernels directly (they iterate every
+// froxel by linear index, never needing to map a light's own view-space Z
+// to a slice), but kept here so a FUTURE consumer (T15's shading pass,
+// mapping a shaded fragment's own view-space Z to its froxel) uses the
+// SAME derivation this file's own froxel-bounds math is built on, and so
+// this task's own GPU test can dispatch this EXACT function and compare
+// against the C++ oracle for the "bit-for-bit" acceptance criterion.
+public uint findSliceZ(float viewSpaceZ, FroxelGridParamsGpu grid) {
+    int s = int(log2(-viewSpaceZ / grid.zLightFar) * grid.invLinearizer + float(grid.countZ));
+    s = viewSpaceZ < 0.0 ? s : 0;
+    s = clamp(s, 0, int(grid.countZ) - 1);
+    return uint(s);
+}
+
+public struct FroxelBoundsGpu {
+    public float3 center;
+    public float radius;
+};
+
+// Port of rx::scene::froxel::froxelViewSpaceBounds() [froxel_grid.cpp] --
+// SAME 8-corner-centroid/max-corner-distance shape as Filament's own
+// updateBoundingSpheres() (Froxelizer.cpp:324-382), corners derived from
+// this engine's symmetric-FOV frustum math (see froxel_grid.h's own top
+// comment on why).
+public FroxelBoundsGpu froxelViewSpaceBounds(uint x, uint y, uint z, FroxelGridParamsGpu grid) {
+    float ndcX0 = -1.0 + 2.0 * float(x) / float(grid.countX);
+    float ndcX1 = -1.0 + 2.0 * float(x + 1) / float(grid.countX);
+    float ndcY0 = -1.0 + 2.0 * float(y) / float(grid.countY);
+    float ndcY1 = -1.0 + 2.0 * float(y + 1) / float(grid.countY);
+
+    float dNear = sliceZDistance(z, grid);
+    float dFar = sliceZDistance(z + 1, grid);
+
+    float tanHalfFovX = grid.tanHalfFovY * grid.aspectRatio;
+
+    float3 corners[8];
+    uint idx = 0;
+    [unroll]
+    for (uint ix = 0; ix < 2; ++ix) {
+        float ndcX = (ix == 0) ? ndcX0 : ndcX1;
+        [unroll]
+        for (uint iy = 0; iy < 2; ++iy) {
+            float ndcY = (iy == 0) ? ndcY0 : ndcY1;
+            [unroll]
+            for (uint id = 0; id < 2; ++id) {
+                float d = (id == 0) ? dNear : dFar;
+                corners[idx] = float3(ndcX * d * tanHalfFovX, ndcY * d * grid.tanHalfFovY, -d);
+                idx = idx + 1;
+            }
+        }
+    }
+
+    float3 center = float3(0.0, 0.0, 0.0);
+    [unroll]
+    for (uint i = 0; i < 8; ++i) {
+        center += corners[i];
+    }
+    center *= (1.0 / 8.0);
+
+    float maxDist2 = 0.0;
+    [unroll]
+    for (uint i = 0; i < 8; ++i) {
+        float3 delta = corners[i] - center;
+        maxDist2 = max(maxDist2, dot(delta, delta));
+    }
+
+    FroxelBoundsGpu result;
+    result.center = center;
+    result.radius = sqrt(maxDist2);
+    return result;
+}
+
+// Port of rx::scene::froxel::sphereIntersectsFroxel() [froxel_grid.cpp].
+public bool sphereIntersectsFroxel(float3 lightViewPos, float lightRadius, FroxelBoundsGpu froxel) {
+    float3 d = lightViewPos - froxel.center;
+    float rr = lightRadius + froxel.radius;
+    return dot(d, d) <= rr * rr;
+}
+
+// Port of rx::scene::froxel::spotIntersectsFroxel() [froxel_grid.cpp,
+// itself porting Intersections.h:50-62's sphereConeIntersectionFast()
+// verbatim, FROXEL as the tested "sphere", LIGHT as the cone origin/axis].
+public bool spotIntersectsFroxel(float3 lightViewPos, float lightRadius, float3 coneAxis, float coneSinInverse,
+                                  float coneCosSquared, FroxelBoundsGpu froxel) {
+    if (!sphereIntersectsFroxel(lightViewPos, lightRadius, froxel)) {
+        return false;
+    }
+    float3 u = lightViewPos - (froxel.radius * coneSinInverse) * coneAxis;
+    float3 d = froxel.center - u;
+    float e = dot(coneAxis, d);
+    float dd = dot(d, d);
+    return (e * e >= dd * coneCosSquared) && (e > 0.0);
+}
+
+// One point/spot light's view-space-transformed data for froxel
+// assignment -- GPU mirror of rx::cluster::ClusterLightGpu
+// (rx_cluster/cluster_lighting.h, kept manually in sync). Every field is a
+// float4 (never a bare float3) so std430-style StructuredBuffer packing
+// needs no implicit padding reasoning on either the Slang or the C++ side
+// -- both lay this struct out identically (three consecutive float4s, 48
+// bytes) by construction.
+public struct ClusterLightGpu {
+    // xyz = view-space position, w = cull radius.
+    public float4 viewPositionRadius;
+    // xyz = spot cone axis in view space (unused, but always finite, for a
+    // point light), w = coneSinInverse (spot only).
+    public float4 viewAxisSinInverse;
+    // x = coneCosSquared (spot only), y = isSpot (1.0 spot / 0.0 point), z/w unused.
+    public float4 cosSquaredFlags;
+};
+
+// The SAME test either count or scatter kernel needs, factored once so
+// both stay byte-for-byte identical to each other (a prerequisite for this
+// task's own two-pass count-then-scatter determinism, since count decides
+// CAPACITY and scatter decides WHICH lights fill it -- any divergence
+// between the two tests would corrupt that contract).
+public bool lightIntersectsFroxel(ClusterLightGpu light, FroxelBoundsGpu froxel) {
+    float3 pos = light.viewPositionRadius.xyz;
+    float radius = light.viewPositionRadius.w;
+    if (light.cosSquaredFlags.y > 0.5) {
+        return spotIntersectsFroxel(pos, radius, light.viewAxisSinInverse.xyz, light.viewAxisSinInverse.w,
+                                     light.cosSquaredFlags.x, froxel);
+    }
+    return sphereIntersectsFroxel(pos, radius, froxel);
+}
diff --git a/shaders/cluster/froxel_light_count.slang b/shaders/cluster/froxel_light_count.slang
new file mode 100644
index 0000000..980ff28
--- /dev/null
+++ b/shaders/cluster/froxel_light_count.slang
@@ -0,0 +1,56 @@
+// shaders/cluster/froxel_light_count.slang -- Phase 5 Stage 2 Task 14
+// [#50], PASS 1 of the count/prefix-sum/scatter clustered light-assignment
+// chain [gate ruling: "light lists via two-pass count+prefix-sum+scatter
+// (NO 256-light bitset cap)"]. This is RendererX's OWN compute-shader
+// EXPRESSION of Filament's froxelization ALGORITHM (gate matrix Open
+// Question #1's licensed scope: Filament's own froxelizer is CPU-side, no
+// GLSL compute source exists to translate literally -- see
+// froxel_common.slang's own top comment for the per-formula port
+// citations this file builds on).
+//
+// ONE THREAD PER FROXEL (1D dispatch over grid.froxelCount()) -- each
+// thread independently loops over EVERY light and counts how many
+// intersect ITS OWN froxel, writing exactly one uint. No cross-thread
+// communication, no atomics: this is what makes the whole 3-pass chain
+// deterministic BY CONSTRUCTION (see froxel_light_scatter.slang's own top
+// comment for why this matters for the determinism acceptance criterion).
+import froxel_common;
+
+[[vk::push_constant]]
+ConstantBuffer<FroxelGridParamsGpu> gGrid;
+
+// set 1, binding 0: the frame's flat point/spot light list (view-space
+// already-transformed -- rx::cluster::buildClusterLightList()'s own
+// output), read-only.
+[[vk::binding(0, 1)]]
+StructuredBuffer<ClusterLightGpu> gLights;
+
+// set 1, binding 1: gTrueCounts[froxelIndex] = the RAW (uncapped)
+// intersecting-light count for that froxel -- pass 2 applies BOTH capacity
+// axes (per-froxel maxLightsPerFroxel, global maxTotalLightIndices)
+// against this true value, so the true count itself is never lost (needed
+// to report an EXACT overflow amount, per the plan's own "counters exact
+// and CI-gateable" acceptance criterion).
+[[vk::binding(1, 1)]]
+RWStructuredBuffer<uint> gTrueCounts;
+
+[shader("compute")]
+[numthreads(64, 1, 1)]
+void csCount(uint3 id : SV_DispatchThreadID) {
+    uint idx = id.x;
+    uint total = froxelCountTotal(gGrid);
+    if (idx >= total) {
+        return;
+    }
+
+    uint3 coords = froxelCoordsFromIndex(idx, gGrid);
+    FroxelBoundsGpu bounds = froxelViewSpaceBounds(coords.x, coords.y, coords.z, gGrid);
+
+    uint count = 0;
+    for (uint i = 0; i < gGrid.totalLightCount; ++i) {
+        if (lightIntersectsFroxel(gLights[i], bounds)) {
+            count = count + 1;
+        }
+    }
+    gTrueCounts[idx] = count;
+}
diff --git a/shaders/cluster/froxel_light_scatter.slang b/shaders/cluster/froxel_light_scatter.slang
new file mode 100644
index 0000000..52bf923
--- /dev/null
+++ b/shaders/cluster/froxel_light_scatter.slang
@@ -0,0 +1,63 @@
+// shaders/cluster/froxel_light_scatter.slang -- Phase 5 Stage 2 Task 14
+// [#50], PASS 3 (final) of the count/prefix-sum/scatter chain.
+//
+// DETERMINISM BY CONSTRUCTION [matrix's own named acceptance criterion:
+// "dispatch the SAME light set + camera... TWICE... assert the per-froxel
+// light-list buffer readback is BYTE-IDENTICAL both times"; explicitly
+// flags "a naive atomic-counter-append implementation... is the design
+// most likely to accidentally FAIL this test"]: this kernel uses **zero
+// atomics**. Each thread owns exactly one froxel's own [offset,
+// offset+writeCount) slice of gLightIndices (gOffsets/gWriteCounts, pass
+// 2's own output, already partitions the buffer into disjoint per-froxel
+// ranges with no overlap) and fills it by re-running the IDENTICAL
+// light-index-ORDER loop pass 1 used to COUNT -- same thread, same
+// sequential order, same lightIntersectsFroxel() test (imported from the
+// SAME froxel_common.slang pass 1 uses, not a re-derived copy) -- so a
+// given (grid, lights) input always produces the exact same output, on
+// any run, on any dispatch/workgroup-size configuration, with no
+// possibility of a race (no two threads ever write the same buffer
+// element, and no thread's own local `written` counter depends on any
+// other thread's progress).
+import froxel_common;
+
+[[vk::push_constant]]
+ConstantBuffer<FroxelGridParamsGpu> gGrid;
+
+[[vk::binding(0, 1)]]
+StructuredBuffer<ClusterLightGpu> gLights;
+
+[[vk::binding(1, 1)]]
+StructuredBuffer<uint> gOffsets;
+
+[[vk::binding(2, 1)]]
+StructuredBuffer<uint> gWriteCounts;
+
+// The global light-index buffer: gLightIndices[gOffsets[f] .. gOffsets[f]+gWriteCounts[f])
+// holds froxel f's own light indices (into gLights), in ascending
+// light-index order -- froxel f's [offset,count) pair (gOffsets[f],
+// gWriteCounts[f]) IS its complete, standalone light list descriptor.
+[[vk::binding(3, 1)]]
+RWStructuredBuffer<uint> gLightIndices;
+
+[shader("compute")]
+[numthreads(64, 1, 1)]
+void csScatter(uint3 id : SV_DispatchThreadID) {
+    uint idx = id.x;
+    uint total = froxelCountTotal(gGrid);
+    if (idx >= total) {
+        return;
+    }
+
+    uint3 coords = froxelCoordsFromIndex(idx, gGrid);
+    FroxelBoundsGpu bounds = froxelViewSpaceBounds(coords.x, coords.y, coords.z, gGrid);
+
+    uint offset = gOffsets[idx];
+    uint capacity = gWriteCounts[idx];
+    uint written = 0;
+    for (uint i = 0; i < gGrid.totalLightCount && written < capacity; ++i) {
+        if (lightIntersectsFroxel(gLights[i], bounds)) {
+            gLightIndices[offset + written] = i;
+            written = written + 1;
+        }
+    }
+}
diff --git a/shaders/cluster/froxel_prefix_sum.slang b/shaders/cluster/froxel_prefix_sum.slang
new file mode 100644
index 0000000..89a289d
--- /dev/null
+++ b/shaders/cluster/froxel_prefix_sum.slang
@@ -0,0 +1,81 @@
+// shaders/cluster/froxel_prefix_sum.slang -- Phase 5 Stage 2 Task 14
+// [#50], PASS 2 of the count/prefix-sum/scatter chain. A single-thread
+// SERIAL exclusive scan over gTrueCounts[] -- deliberately not a
+// parallel/work-efficient scan: this project's own froxel grid budget is
+// modest by design (kDefaultFroxelBudget = 8192, matching Filament's own
+// FROXEL_BUFFER_MAX_ENTRY_COUNT, froxel_grid.h), so a serial O(froxelCount)
+// loop costs microseconds on any GPU this engine targets (measured this
+// task -- see task-14-report.md's own timing breakdown) and keeps the
+// determinism/correctness proof trivial (a single thread's own strictly-
+// ordered read-modify-write has no parallel-scan synchronization to get
+// wrong at all). A work-efficient parallel scan (Hillis-Steele/Blelloch)
+// is a documented, deferred optimization opportunity if a future content-
+// scale target needs a materially larger froxel budget than this one --
+// not exercised here because nothing in this phase's own scale target
+// requires it.
+//
+// Applies BOTH capacity axes named by the plan's own acceptance criterion
+// (plan:504-505, "max lights per froxel / total... counters exact and
+// CI-gateable") in one pass:
+//   1. PER-FROXEL cap (gGrid.maxLightsPerFroxel): gTrueCounts[i] is capped
+//      before it can consume any of the global light-index buffer;
+//      gPerFroxelOverflow[i] reports exactly how much was cut.
+//   2. GLOBAL cap (gGrid.maxTotalLightIndices): the running prefix-sum
+//      total is clamped against the global light-index buffer's own
+//      declared capacity; gGlobalOverflow[i] reports exactly how much of
+//      THIS froxel's (already per-froxel-capped) count could not fit.
+// Both overflow counters are EXACT (never "hasOverflow" booleans) and
+// PER-FROXEL (a scene with one saturated froxel never corrupts any other
+// froxel's own list -- the plan's own "contained, not corrupt" acceptance
+// text), matching CLAUDE.md's own capacity+1 standing rule.
+import froxel_common;
+
+[[vk::push_constant]]
+ConstantBuffer<FroxelGridParamsGpu> gGrid;
+
+[[vk::binding(0, 1)]]
+StructuredBuffer<uint> gTrueCounts;
+
+[[vk::binding(1, 1)]]
+RWStructuredBuffer<uint> gOffsets;
+
+[[vk::binding(2, 1)]]
+RWStructuredBuffer<uint> gWriteCounts;
+
+[[vk::binding(3, 1)]]
+RWStructuredBuffer<uint> gPerFroxelOverflow;
+
+[[vk::binding(4, 1)]]
+RWStructuredBuffer<uint> gGlobalOverflow;
+
+// A single scalar (index 0 only) -- the total number of light-index
+// entries pass 3 will actually scatter this frame (sum of every
+// gWriteCounts[i]), the exact size a caller should read back from
+// gLightIndices rather than assuming the whole maxTotalLightIndices-sized
+// buffer is meaningful.
+[[vk::binding(5, 1)]]
+RWStructuredBuffer<uint> gTotalUsed;
+
+[shader("compute")]
+[numthreads(1, 1, 1)]
+void csPrefixSum(uint3 id : SV_DispatchThreadID) {
+    uint total = froxelCountTotal(gGrid);
+    uint running = 0;
+    for (uint i = 0; i < total; ++i) {
+        uint trueCount = gTrueCounts[i];
+        uint capped = min(trueCount, gGrid.maxLightsPerFroxel);
+        uint perFroxelOverflow = trueCount - capped;
+
+        uint remaining = gGrid.maxTotalLightIndices > running ? (gGrid.maxTotalLightIndices - running) : 0;
+        uint used = min(capped, remaining);
+        uint globalOverflow = capped - used;
+
+        gOffsets[i] = running;
+        gWriteCounts[i] = used;
+        gPerFroxelOverflow[i] = perFroxelOverflow;
+        gGlobalOverflow[i] = globalOverflow;
+
+        running = running + used;
+    }
+    gTotalUsed[0] = running;
+}
