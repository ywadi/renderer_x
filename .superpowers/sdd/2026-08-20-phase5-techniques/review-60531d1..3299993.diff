+// shaders/ibl/dfg_lut.slang -- Phase 5 Stage 1 Task 9 [#45, gate rulings
+// T9/RC1]: the DFG (BRDF-integration) LUT -- a flat 2D image, NOT a
+// cubemap, no source environment read needed at all (purely procedural,
+// a function of (NoV, roughness) alone). This is what activates Task 8's
+// waiting `energyCompensation(f0, dfgY)` [shaders/material/brdf.slang:
+// 219-221] with a REAL, backed value: `dfgY` is this LUT's G channel.
+//
+// PORT PROVENANCE -- google/filament v1.75.0 (tag; commit
+// 0e58877c09afb1aacd09ff640f74d2adcd2a7e80, Apache-2.0), libs/ibl/src/
+// CubemapIBL.cpp:
+//   - DFV_Multiscatter() (:790-833) -- ported exactly below as
+//     dfvMultiscatter(). multiscatter=true is used UNCONDITIONALLY (never
+//     the plain, non-multiscatter DFV() at :748-788) -- this is not a
+//     free choice: Task 8's energyCompensation(f0, dfgY) formula (`1 +
+//     f0*(1/dfgY - 1)`) is the Kulla-Conty multiscatter identity keyed
+//     EXACTLY on DFV_Multiscatter's own `.y` channel (`Ess`, the
+//     single-scatter energy sum with no Fresnel term -- see that
+//     function's own header comment: "Er() = (1-f0)*DFV.x + f0*DFV.y").
+//     Feeding the plain (non-multiscatter) DFV()'s own `.y` channel into
+//     that exact formula would be a DIFFERENT, WRONG quantity (DFV's own
+//     comment: "Er() = f0*DFV.x + f90*DFV.y", not the same identity at
+//     all) -- Task 8's own calling contract (brdf.slang's header comment)
+//     is written against the multiscatter formulation specifically.
+//   - Visibility() (CubemapIBL.cpp:170-177) -- the SAME height-correlated
+//     Smith visibility term shaders/material/brdf.slang's own
+//     V_SmithGGXCorrelated() already ports (Task 7) -- duplicated here
+//     rather than imported, matching this codebase's own established
+//     per-file-duplicated-helper idiom for standalone compute kernels
+//     (see irradiance_convolve.slang's header comment).
+//   - CubemapIBL::DFG() (:1008-1037) -- the (x,y) texel -> (NoV,
+//     linearRoughness) parameterization ported exactly: `coord =
+//     saturate((height - y + 0.5) / height)`, `linearRoughness = coord *
+//     coord` (row 0 = roughest, the LAST row = smoothest/mirror -- see
+//     this task's own analytic test for the closed-form low-roughness
+//     row this parameterization makes exact); `NoV = saturate((x + 0.5) /
+//     width)`. `cloth`=false always (unconditionally) -- no cloth/sheen
+//     BRDF exists in this codebase yet (Task 27/34 registry pointers);
+//     the CPU original's own `cloth` branch (DFV_Charlie_Uniform into the
+//     B channel) is simply never taken, matching this LUT's own 2-channel
+//     (R16G16) storage shape, which has no third channel to carry it in
+//     anyway.
+
+struct PushConstants {
+    uint width;
+    uint height;
+    uint numSamples;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 1)]]
+RWTexture2D<float2> gOutLut;
+
+static const float kPi = 3.14159265358979323846;
+
+float2 hammersley(uint i, float iN) {
+    uint bits = i;
+    bits = (bits << 16u) | (bits >> 16u);
+    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
+    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
+    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
+    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
+    return float2(float(i) * iN, float(bits) * (1.0 / 4294967296.0));
+}
+
+float3 hemisphereImportanceSampleDggx(float2 u, float a) {
+    float phi = 2.0 * kPi * u.x;
+    float cosTheta2 = (1.0 - u.y) / (1.0 + (a + 1.0) * ((a - 1.0) * u.y));
+    float cosTheta = sqrt(max(0.0, cosTheta2));
+    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta2));
+    return float3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
+}
+
+// [CubemapIBL.cpp:170-177] Visibility(), ported exactly, with an added
+// fp32 div-by-zero guard (1e-5) matching brdf.slang's own kDiv0Epsilon
+// precedent (Task 7) -- the CPU original has no such guard (a CPU double-
+// precision divide-by-a-tiny-nonzero-number is merely imprecise, never a
+// GPU-fp32 NaN/Inf risk the way a genuine zero denominator would be at an
+// exact grazing angle).
+float visibilityTerm(float noV, float noL, float a) {
+    float a2 = a * a;
+    float ggxL = noV * sqrt(max(0.0, (noL - noL * a2) * noL + a2));
+    float ggxV = noL * sqrt(max(0.0, (noV - noV * a2) * noV + a2));
+    return 0.5 / max(ggxV + ggxL, 1e-5);
+}
+
+// [CubemapIBL.cpp:790-833] DFV_Multiscatter(), ported exactly.
+float2 dfvMultiscatter(float noV, float linearRoughness, uint numSamples) {
+    float2 r = float2(0.0, 0.0);
+    float3 v = float3(sqrt(max(0.0, 1.0 - noV * noV)), 0.0, noV);
+    float invN = 1.0 / float(numSamples);
+    for (uint i = 0; i < numSamples; i++) {
+        float2 xi = hammersley(i, invN);
+        float3 h = hemisphereImportanceSampleDggx(xi, linearRoughness);
+        float dotVH = dot(v, h);
+        float3 l = 2.0 * dotVH * h - v;
+        float voH = saturate(dotVH);
+        float noL = saturate(l.z);
+        float noH = saturate(h.z);
+        if (noL > 0.0) {
+            float term = visibilityTerm(noV, noL, linearRoughness) * noL * (voH / max(noH, 1e-6));
+            float fc = pow(clamp(1.0 - voH, 0.0, 1.0), 5.0);
+            r.x += term * fc;
+            r.y += term;
+        }
+    }
+    return r * (4.0 / float(numSamples));
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void csMain(uint3 id: SV_DispatchThreadID) {
+    if (id.x >= gPush.width || id.y >= gPush.height) {
+        return;
+    }
+    float h = float(gPush.height);
+    float coord = saturate((h - float(id.y) + 0.5) / h);
+    float linearRoughness = coord * coord;
+    float noV = saturate((float(id.x) + 0.5) / float(gPush.width));
+    float2 dfg = dfvMultiscatter(noV, linearRoughness, gPush.numSamples);
+    gOutLut[id.xy] = dfg;
+}
diff --git a/shaders/ibl/equirect_to_cubemap.slang b/shaders/ibl/equirect_to_cubemap.slang
new file mode 100644
index 0000000..22838ab
--- /dev/null
+++ b/shaders/ibl/equirect_to_cubemap.slang
@@ -0,0 +1,114 @@
+// shaders/ibl/equirect_to_cubemap.slang -- Phase 5 Stage 1 Task 9 [#45,
+// gate rulings T9/RC1]: equirectangular HDR environment -> cubemap
+// projection, the first stage of the IBL bake chain. One compute pass per
+// destination FACE -- rx_graph's rx::rhi::StorageImage exposes no writable
+// 2D-ARRAY view spanning all 6 faces of a cube image at once (a full
+// 6-layer subresource request on a cube-flagged image always resolves to
+// a VK_IMAGE_VIEW_TYPE_CUBE view, per storage_image.h's own
+// viewForSubresource() doc comment), and Slang/HLSL has no RWTextureCube
+// write-target type at all -- so per-face 2D dispatch is this codebase's
+// only available shape for a cube compute WRITE, confirmed directly
+// against Task 2's own GPU test (rx_graph/tests/test_compute_gpu.cpp's
+// "two compute passes writing DISJOINT faces of a cube storage image"
+// case), not merely assumed.
+//
+// PORT PROVENANCE -- ported from google/filament v1.75.0 (tag; commit
+// 0e58877c09afb1aacd09ff640f74d2adcd2a7e80, Apache-2.0):
+//   - libs/ibl/include/ibl/Cubemap.h, Cubemap::getDirectionFor()
+//     (:160-180) -- getDirectionForFace() below is this formula
+//     re-derived byte-for-byte (x/y -> [-1,1] via `cx = u*2-1`,
+//     `cy = 1-v*2`, then a per-face switch). Independently cross-checked
+//     (this task's own report) against the standard Vulkan/OpenGL
+//     hardware cube-face convention (VK_IMAGE_VIEW_TYPE_CUBE's own layer
+//     order, +X=0,-X=1,+Y=2,-Y=3,+Z=4,-Z=5) and found algebraically
+//     IDENTICAL -- Filament's CPU convention already matches hardware
+//     cube addressing, which is why this port can safely feed a real
+//     TextureCube sampled read downstream (irradiance_convolve.slang /
+//     prefilter_specular.slang) without a face-order mismatch. A
+//     dedicated GPU test (test_ibl_cube_face_convention_gpu.cpp) proves
+//     this directly: writes 6 distinct known colors through this exact
+//     per-face-index scheme, then samples the resulting image as a real
+//     hardware TextureCube at the 6 canonical axis directions and checks
+//     each returns the texel written to the correspondingly-INDEXED face.
+//   - libs/ibl/src/CubemapUtils.cpp, CubemapUtils::equirectangularToCubemap()
+//     (:182-238) -- directionToEquirectUv() below is toRectilinear()
+//     (:186-192) ported exactly (`atan2(x,z)/PI`, `asin(y)*2/PI`, remapped
+//     to [0,1] UV). DELIBERATE SIMPLIFICATION vs the CPU original: the
+//     original supersamples each destination texel with a Hammersley-
+//     jittered box filter over its own footprint in equirect pixel space
+//     (CubemapUtils.cpp:196-233), because ITS only read primitive is a
+//     hand-indexed nearest-neighbour CPU buffer fetch (Cubemap::sampleAt()
+//     there has no hardware filtering to lean on at all). This GPU port
+//     instead takes ONE bilinear-filtered hardware sample per destination
+//     texel (VkSampler linear filtering already anti-aliases the read
+//     cheaply) -- a documented simplification, not a missed formula; the
+//     underlying direction<->equirect-UV mapping itself is ported exactly.
+
+struct PushConstants {
+    uint faceIndex;  // 0=+X,1=-X,2=+Y,3=-Y,4=+Z,5=-Z (Vulkan/Filament-standard cube layer order)
+    uint faceDim;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 1)]]
+Texture2D<float4> gEquirect;
+
+[[vk::binding(1, 1)]]
+SamplerState gEquirectSampler;
+
+[[vk::binding(2, 1)]]
+RWTexture2D<float4> gOutFace;
+
+static const float kPi = 3.14159265358979323846;
+
+// [Cubemap.h:160-180] `u`/`v` are texel-center-normalized [0,1] (the
+// caller applies the "+0.5" Cubemap::center() convention before calling).
+float3 getDirectionForFace(uint face, float u, float v) {
+    float cx = u * 2.0 - 1.0;
+    float cy = 1.0 - v * 2.0;
+    float3 dir;
+    if (face == 0u) {
+        dir = float3(1.0, cy, -cx);
+    } else if (face == 1u) {
+        dir = float3(-1.0, cy, cx);
+    } else if (face == 2u) {
+        dir = float3(cx, 1.0, -cy);
+    } else if (face == 3u) {
+        dir = float3(cx, -1.0, cy);
+    } else if (face == 4u) {
+        dir = float3(cx, cy, 1.0);
+    } else {
+        dir = float3(-cx, cy, -1.0);
+    }
+    return normalize(dir);
+}
+
+// [CubemapUtils.cpp:186-192] toRectilinear(), ported exactly (the
+// `(width-1)`/`(height-1)` pixel-index scaling in the CPU original is
+// specific to its own hand-indexed buffer fetch -- this port's hardware
+// sampler takes normalized [0,1] UV directly, so that scaling has no
+// analog here; the direction<->longitude/latitude mapping itself is
+// unchanged).
+float2 directionToEquirectUv(float3 s) {
+    float xf = atan2(s.x, s.z) * (1.0 / kPi);
+    float yf = asin(clamp(s.y, -1.0, 1.0)) * (2.0 / kPi);
+    float u = (xf + 1.0) * 0.5;
+    float v = (1.0 - yf) * 0.5;
+    return float2(u, v);
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void csMain(uint3 id: SV_DispatchThreadID) {
+    if (id.x >= gPush.faceDim || id.y >= gPush.faceDim) {
+        return;
+    }
+    float u = (float(id.x) + 0.5) / float(gPush.faceDim);
+    float v = (float(id.y) + 0.5) / float(gPush.faceDim);
+    float3 dir = getDirectionForFace(gPush.faceIndex, u, v);
+    float2 eq = directionToEquirectUv(dir);
+    float4 color = gEquirect.SampleLevel(gEquirectSampler, eq, 0.0);
+    gOutFace[id.xy] = float4(color.rgb, 1.0);
+}
diff --git a/shaders/ibl/irradiance_convolve.slang b/shaders/ibl/irradiance_convolve.slang
new file mode 100644
index 0000000..3184741
--- /dev/null
+++ b/shaders/ibl/irradiance_convolve.slang
@@ -0,0 +1,139 @@
+// shaders/ibl/irradiance_convolve.slang -- Phase 5 Stage 1 Task 9 [#45,
+// gate rulings T9 per-ticket ruling: irradiance-CUBEMAP baseline, SH9
+// recorded as a later optional optimization -- see rulings-2026-08-20.md].
+// Diffuse irradiance convolution: cosine-weighted importance-sampled
+// average of the source (base) cubemap over the hemisphere around each
+// destination texel's own direction.
+//
+// PORT PROVENANCE -- google/filament v1.75.0 (tag; commit
+// 0e58877c09afb1aacd09ff640f74d2adcd2a7e80, Apache-2.0), libs/ibl/src/
+// CubemapIBL.cpp, CubemapIBL::diffuseIrradiance() (:554-634):
+// hemisphereCosSample() (:59-65) + the per-texel accumulation loop
+// (:610-633) ported exactly -- `Ed() = (1/N) * sum L(l)`, the SAME
+// "avoid the 1/PI multiply in the shader" pre-division convention the
+// original's own header comment documents (CubemapIBL.cpp:544-551): the
+// PI cancellation from the cosine-weighted-importance-sampling estimator
+// is already folded into the `(1/N)` normalization below, so a
+// downstream Lambertian consumer multiplies this cubemap's own sampled
+// value by `albedo` alone, no extra `/PI`. This is the analytic ground
+// truth this task's tests key on: convolving a spatially UNIFORM
+// environment of radiance L0 with ANY normalized weighting (this
+// includes cosine-importance-sampling, since the per-sample weights are
+// implicitly uniform for a uniform L) yields exactly L0, independent of
+// sample count -- verified in this port's own test suite
+// (test_ibl_analytic_gpu.cpp).
+//
+// DELIBERATE SIMPLIFICATION vs the CPU original (documented, not a missed
+// formula -- see equirect_to_cubemap.slang's own header comment for the
+// same class of simplification applied there): the CPU original reads
+// from a PRE-DOWNSAMPLED mip chain (`levels`, CubemapIBL.h's own
+// `Slice<const Cubemap> levels` parameter) to bias each importance sample
+// toward a coarser LOD for noise reduction ("filtered importance
+// sampling", Krivanek/Colbert -- a variance-reduction/perf optimization
+// layered on TOP of the core unbiased Monte-Carlo estimator, not a
+// correctness requirement of the estimator itself, per the CPU source's
+// own header comment at CubemapIBL.cpp:497-552). This port reads every
+// sample from the SOURCE cubemap's own single mip 0 via hardware
+// TRILINEAR-filtered (seamless cross-face) TextureCube sampling instead
+// -- still a convergent, unbiased cosine-weighted estimator of the same
+// integral, just noisier at a fixed sample count; offset here by a
+// generous sample budget since this bake runs once at load time, never
+// per-frame.
+
+struct PushConstants {
+    uint faceIndex;
+    uint faceDim;
+    uint numSamples;
+};
+
+[[vk::push_constant]]
+ConstantBuffer<PushConstants> gPush;
+
+[[vk::binding(0, 1)]]
+TextureCube<float4> gSourceCube;
+
+[[vk::binding(1, 1)]]
+SamplerState gSourceSampler;
+
+[[vk::binding(2, 1)]]
+RWTexture2D<float4> gOutFace;
+
+static const float kPi = 3.14159265358979323846;
+
+// Duplicated from equirect_to_cubemap.slang -- this codebase's own
+// established per-file-duplicated-helper idiom for small standalone
+// compute kernels (see e.g. test_standard_pbr_energy_compensation_gpu.cpp's
+// own header comment on why its synthetic kernel duplicates
+// hammersley()/hemisphereImportanceSampleDggx() rather than importing a
+// shared module: rx::shader::Compiler's compileFromFile() has no
+// configured cross-file Slang import search path in this codebase, so
+// keeping each standalone kernel single-file avoids a fragile,
+// unverified import-resolution dependency).
+float3 getDirectionForFace(uint face, float u, float v) {
+    float cx = u * 2.0 - 1.0;
+    float cy = 1.0 - v * 2.0;
+    float3 dir;
+    if (face == 0u) {
+        dir = float3(1.0, cy, -cx);
+    } else if (face == 1u) {
+        dir = float3(-1.0, cy, cx);
+    } else if (face == 2u) {
+        dir = float3(cx, 1.0, -cy);
+    } else if (face == 3u) {
+        dir = float3(cx, -1.0, cy);
+    } else if (face == 4u) {
+        dir = float3(cx, cy, 1.0);
+    } else {
+        dir = float3(-cx, cy, -1.0);
+    }
+    return normalize(dir);
+}
+
+// [utilities.h, standard low-discrepancy radical-inverse sequence -- same
+// formula this codebase's own test_standard_pbr_energy_compensation_gpu.cpp
+// already duplicates for the identical reason.]
+float2 hammersley(uint i, float iN) {
+    uint bits = i;
+    bits = (bits << 16u) | (bits >> 16u);
+    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
+    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
+    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
+    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
+    return float2(float(i) * iN, float(bits) * (1.0 / 4294967296.0));
+}
+
+// [CubemapIBL.cpp:59-65] hemisphereCosSample(), ported exactly.
+float3 hemisphereCosSample(float2 u) {
+    float phi = 2.0 * kPi * u.x;
+    float cosTheta2 = 1.0 - u.y;
+    float cosTheta = sqrt(max(0.0, cosTheta2));
+    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta2));
+    return float3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void csMain(uint3 id: SV_DispatchThreadID) {
+    if (id.x >= gPush.faceDim || id.y >= gPush.faceDim) {
+        return;
+    }
+    float u = (float(id.x) + 0.5) / float(gPush.faceDim);
+    float v = (float(id.y) + 0.5) / float(gPush.faceDim);
+    float3 N = getDirectionForFace(gPush.faceIndex, u, v);
+
+    // [CubemapIBL.cpp:616-620] Tangent basis centered on N -- "handle case
+    // of normal close to up" ported exactly.
+    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
+    float3 tangentX = normalize(cross(up, N));
+    float3 tangentY = cross(N, tangentX);
+
+    float3 accum = float3(0.0, 0.0, 0.0);
+    float invN = 1.0 / float(gPush.numSamples);
+    for (uint i = 0; i < gPush.numSamples; i++) {
+        float2 xi = hammersley(i, invN);
+        float3 ls = hemisphereCosSample(xi);
+        float3 dir = tangentX * ls.x + tangentY * ls.y + N * ls.z;
+        accum += gSourceCube.SampleLevel(gSourceSampler, dir, 0.0).rgb;
+    }
+    gOutFace[id.xy] = float4(accum * invN, 1.0);
+}
diff --git a/shaders/ibl/prefilter_specular.slang b/shaders/ibl/prefilter_specular.slang
new file mode 100644
index 0000000..1daef32
