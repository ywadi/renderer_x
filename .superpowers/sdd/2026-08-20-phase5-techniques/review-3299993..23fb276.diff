+| 1 | 0.0625 | 0° | 0.572266 | 0.573597 | 0.0013 |
+| 1 | 0.0625 | 16° | 0.049072 | 0.048633 | 0.0004 |
+| 2 | 0.25 | 0° | 0.094177 | 0.094734 | 0.0006 |
