+// BRDF_specularGGX()/F_Schlick() confirm the identical shape). Plus [FG1,
+// issue comment 2] an interim flat ambient/environment term (uniform color
+// x occlusion) so metals never render pure black pre-IBL -- the full
+// skybox+IBL environment path is registered for the techniques phase, not
+// built here.
+//
+// TEXTURE SLOTS -- every texture-index field below is D11's bindless-
+// index convention: ALWAYS a valid, real texture (Registry/TextureCache's
+// own role-appropriate fallback -- white for baseColor/occlusion/
+// metallicRoughness/emissive, flat-normal for normalTexture -- when the
+// source glTF material has no reference for that slot at all), so this
+// module carries no separate "has texture" boolean anywhere; sampling a
+// role-neutral fallback multiplies/blends to exactly the "texture absent"
+// behavior glTF's own factor defaults already specify.
+import material;
+
+struct StandardPbrParams {
+    // --- Base color [universal glTF default: (1,1,1,1)] ---
+    float4 baseColorFactor;
+
+    // --- Metallic-roughness [universal glTF defaults: both 1.0] ---
+    float metallicFactor;
+    float roughnessFactor;
+
+    // --- Normal map scale [glTF default: 1.0] ---
+    float normalScale;
+
+    // --- Occlusion strength [glTF default: 1.0] ---
+    float occlusionStrength;
+
+    // [D28] MASK's cutoff -- see unlit.slang's identical field for the full
+    // "always-present conditional discard, alphaMode itself lives in
+    // VkPipeline fixed-function state" rationale (MaterialFixedFunctionState,
+    // material_system.h). OPAQUE/BLEND instances bind 0.0 (never discards).
+    float alphaCutoff;
+
+    // xyz = emissiveFactor [glTF default: (0,0,0)], PRE-MULTIPLIED by
+    // KHR_materials_emissive_strength at bind time (the multiply this
+    // module would otherwise need a fourth uniform for -- folding it into
+    // the CPU-side bind avoids widening this struct for a log-don't-drop
+    // extension per the gate matrix's own disposition). w unused (padding).
+    float4 emissiveFactorAndPad;
+
+    // D11 bindless indices -- see this file's own header comment.
+    uint baseColorTexture;
+    uint metallicRoughnessTexture;
+    uint normalTexture;
+    uint occlusionTexture;
+    uint emissiveTexture;
+
+    // KHR_texture_transform per texture slot [consume-now, gate ruling C4]:
+    // xy = UV offset, zw = UV scale. Neutral default (0,0,1,1) per slot.
+    float4 baseColorUvOffsetScale;
+    float4 metallicRoughnessUvOffsetScale;
+    float4 normalUvOffsetScale;
+    float4 occlusionUvOffsetScale;
+    float4 emissiveUvOffsetScale;
+};
+
+[[vk::binding(0, 1)]]
+ParameterBlock<StandardPbrParams> gParams;
+
+static const float kPi = 3.14159265358979323846;
+
+// GGX alpha (roughness^2, the Disney/UE "remap" every first-tier engine
+// applies before feeding roughness into D/V) is clamped away from exactly
+// 0 -- an unclamped roughness=0 drives D_GGX's denominator to exactly 0 at
+// NdotH==1 (a true singularity, not just a large-but-finite number), which
+// would return NaN/Inf for a perfectly smooth mirror surface. 0.045 is the
+// Filament-precedent minimum perceptual roughness (documented in Filament's
+// own PBR chapter as the smallest value its own implementation clamps to
+// for the identical reason).
+static const float kMinRoughness = 0.045;
+
+struct StandardPbr : IMaterialShader {
+    float4 evaluate(MaterialVertex v) {
+        // --- Base color ---------------------------------------------------
+        float2 baseColorUv = v.uv * gParams.baseColorUvOffsetScale.zw + gParams.baseColorUvOffsetScale.xy;
+        float4 baseColor = gParams.baseColorFactor * rx_sampleTexture(gParams.baseColorTexture, baseColorUv);
+
+        // [D28] Always-present conditional discard -- see
+        // StandardPbrParams::alphaCutoff's own comment above.
+        if (baseColor.a < gParams.alphaCutoff) {
+            discard;
+        }
+
+        // --- Metallic-roughness [core spec, quoted in the gate matrix:
+        // "green channel contains roughness... blue channel contains
+        // metalness"] --------------------------------------------------
+        float2 mrUv = v.uv * gParams.metallicRoughnessUvOffsetScale.zw + gParams.metallicRoughnessUvOffsetScale.xy;
+        float4 mrSample = rx_sampleTexture(gParams.metallicRoughnessTexture, mrUv);
+        float roughness = clamp(gParams.roughnessFactor * mrSample.g, kMinRoughness, 1.0);
+        float metallic = clamp(gParams.metallicFactor * mrSample.b, 0.0, 1.0);
+
+        // --- Tangent-space normal mapping, BC5 two-channel + Z
+        // reconstruction [D10: normal -> BC5_UNORM, "Z reconstructed in
+        // shader"] -----------------------------------------------------
+        float2 nUv = v.uv * gParams.normalUvOffsetScale.zw + gParams.normalUvOffsetScale.xy;
+        float4 nSample = rx_sampleTexture(gParams.normalTexture, nUv);
+        // [0,1] texel -> [-1,1] tangent-space XY, scaled by normalScale
+        // BEFORE reconstruction (standard convention: scale perturbs the
+        // tangent-plane offset, not the reconstructed unit length).
+        float2 tangentXY = (nSample.rg * 2.0 - 1.0) * gParams.normalScale;
+        // Radicand clamp [acceptance criterion]: a known BC5 artifact can
+        // push a decoded (x,y) marginally outside the unit circle, which
+        // would otherwise produce a negative radicand (NaN via sqrt) --
+        // max(0, ...) clamps it to the equator (z=0) instead of failing.
+        float radicand = max(0.0, 1.0 - dot(tangentXY, tangentXY));
+        float3 tangentSpaceNormal = float3(tangentXY, sqrt(radicand));
+
+        float3 geometricNormal = normalize(v.normal);
+        // Gram-Schmidt re-orthogonalize against the (already normalized)
+        // geometric normal -- linear interpolation across a triangle does
+        // not preserve exact tangent/normal perpendicularity even when
+        // both inputs were unit-length and orthogonal at every vertex.
+        float3 tangent = normalize(v.tangent.xyz - geometricNormal * dot(geometricNormal, v.tangent.xyz));
+        // MikkTSpace/glTF convention [acceptance criterion, sign test]:
+        // bitangent = cross(normal, tangent.xyz) * tangent.w.
+        float3 bitangent = cross(geometricNormal, tangent) * v.tangent.w;
+        // Rows T/B/N: mul(vector, M) in Slang/HLSL treats `vector` as a ROW
+        // vector against M's own rows as basis vectors -- i.e. this computes
+        // exactly `tangentSpaceNormal.x * T + tangentSpaceNormal.y * B +
+        // tangentSpaceNormal.z * N`, the standard TBN transform, tangent- ->
+        // world-space.
+        float3x3 tbn = float3x3(tangent, bitangent, geometricNormal);
+        float3 N = normalize(mul(tangentSpaceNormal, tbn));
+
+        // --- Occlusion [core spec closed-form formula, quoted in the gate
+        // matrix: "1.0 + strength * (occlusionTexture - 1.0)"] ----------
+        float2 occUv = v.uv * gParams.occlusionUvOffsetScale.zw + gParams.occlusionUvOffsetScale.xy;
+        float occSample = rx_sampleTexture(gParams.occlusionTexture, occUv).r;
+        float occlusion = 1.0 + gParams.occlusionStrength * (occSample - 1.0);
+
+        // --- Emissive -------------------------------------------------
+        float2 emUv = v.uv * gParams.emissiveUvOffsetScale.zw + gParams.emissiveUvOffsetScale.xy;
+        float3 emissive = gParams.emissiveFactorAndPad.xyz * rx_sampleTexture(gParams.emissiveTexture, emUv).rgb;
+
+        // --- Lambertian diffuse + GGX/Smith-correlated/Schlick specular,
+        // one directional light [BRDF baseline, this file's own header
+        // comment] --------------------------------------------------
+        float3 viewDir = normalize(v.cameraPosWorld - v.worldPos);
+        float3 lightDir = normalize(v.lightDirWorld);
+        float3 halfVec = normalize(viewDir + lightDir);
+        float NdotL = max(dot(N, lightDir), 0.0);
+        float NdotV = max(dot(N, viewDir), 1e-4);  // clamped away from 0, not 0-able geometry (grazing/back-facing).
+        float NdotH = max(dot(N, halfVec), 0.0);
+        float VdotH = max(dot(viewDir, halfVec), 0.0);
+
+        // Dielectric F0 = 0.04 [glTF/Disney-convention default, matching
+        // this project's own already-fixed constant per the gate matrix's
+        // KHR_materials_ior row]; metals use their own baseColor as F0
+        // (the standard metallic-workflow lerp).
+        float3 dielectricF0 = float3(0.04, 0.04, 0.04);
+        float3 F0 = lerp(dielectricF0, baseColor.rgb, metallic);
+        float3 diffuseColor = baseColor.rgb * (1.0 - metallic);  // metals have zero diffuse.
+
+        float alpha = roughness * roughness;
+        float alpha2 = alpha * alpha;
+
+        // D_GGX.
+        float denomD = (NdotH * NdotH) * (alpha2 - 1.0) + 1.0;
+        float D = alpha2 / (kPi * denomD * denomD);
+
+        // V_SmithGGXCorrelated -- height-correlated visibility, already
+        // divides out the classic 4*NdotL*NdotV denominator (Filament's own
+        // documented form, matching this file's header comment).
+        float lambdaV = NdotL * sqrt(NdotV * NdotV * (1.0 - alpha2) + alpha2);
+        float lambdaL = NdotV * sqrt(NdotL * NdotL * (1.0 - alpha2) + alpha2);
+        float vis = 0.5 / max(lambdaV + lambdaL, 1e-5);
+
+        // F_Schlick.
+        float3 oneMinusF0 = float3(1.0, 1.0, 1.0) - F0;
+        float3 fresnel = F0 + oneMinusF0 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
+
+        float3 specular = D * vis * fresnel;
+        float3 diffuse = diffuseColor / kPi;
+
+        float3 directLight = (diffuse + specular) * v.lightColor * NdotL;
+
+        // [FG1] Interim flat ambient/environment term -- uniform color x
+        // occlusion x baseColor, the EXACT closed-form the acceptance
+        // criterion's non-black-metal probe checks, independent of
+        // metallic/NdotL (a fully-metallic surface has zero diffuse but
+        // still gets this contribution -- the whole point of FG1).
+        float3 ambient = v.ambientColor * occlusion * baseColor.rgb;
+
+        float3 color = directLight * occlusion + ambient + emissive;
+        return float4(color, baseColor.a);
+    }
+};
+
+export struct MaterialImpl : IMaterialShader = StandardPbr;
diff --git a/shaders/material/unlit.slang b/shaders/material/unlit.slang
new file mode 100644
index 0000000..a00c28c
--- /dev/null
+++ b/shaders/material/unlit.slang
@@ -0,0 +1,101 @@
+// shaders/material/unlit.slang -- Phase 4 Stage 1 Task 16 [D22, gate ruling
+// #8, KHR_materials_unlit]: an ordinary public IMaterialShader module (zero
+// special treatment -- loaded via the same MaterialSystem::loadMaterial()
+// every other material uses), mapping glTF's KHR_materials_unlit extension
+// 1:1 onto this engine's material system.
+//
+// SEMANTICS -- quoted directly from the extension's own README (fetched
+// 2026-08-18, gate matrix-issue08's own verified citation): color is "the
+// product of baseColorFactor, baseColorTexture, and vertex color (if any),
+// as defined by the core glTF material specification", rendered as "a
+// constantly shaded surface that is independent of lighting". Vertex color
+// (COLOR_0) stays the already-ruled D7 import-time deferral (log-don't-drop
+// -- see material.slang's own MaterialVertex header comment for the
+// extension point) -- this module has no COLOR_0 input to multiply in the
+// first place, so nothing here silently drops it beyond what D7 already
+// decided.
+//
+// ZERO LIGHTING DEPENDENCE [acceptance criterion: a light-flip zero-delta
+// probe] -- this module's evaluate() reads `v.normal`/`v.tangent`/
+// `v.lightDirWorld`/`v.lightColor`/`v.ambientColor`/`v.cameraPosWorld` only
+// through a negligible (1e-6-scale) ADDITIVE epsilon (see below), matching
+// test_unlit.slang's own established convention (that file's own header
+// comment has the full rationale + a direct empirical citation). An EARLIER
+// version of this file tried the same `* 0.0` (exact-zero-multiply)
+// technique samples/06_materials/materials/checker.slang's own
+// `checkerTexIndex` field uses -- verified DURING THIS TASK's own
+// development to NOT survive Slang's SPIR-V interface-elimination pass for
+// a VERTEX-STAGE INTERPOLANT specifically (unlike a `gParams` UNIFORM
+// read): `x * 0.0` is a provable-constant-zero algebraic identity the
+// optimizer folds away BEFORE any interpolant-liveness analysis runs,
+// re-triggering the exact "vertex shader writes an output location not
+// consumed by the fragment shader" validation warning this trick was meant
+// to avoid -- reproduced directly (`--validate`,
+// UNASSIGNED-CoreValidation-Shader-OutputNotConsumed) against this
+// project's real GPU test fixture before switching to the additive form.
+// A genuinely small ADDITIVE term (1e-6) is NOT a provable-zero identity to
+// the optimizer (it depends on the real runtime value), so the read
+// survives -- and is small enough that its effect on an 8-bit UNORM
+// readback is below one quantization step (1/255 ~= 0.0039), which is what
+// makes the light-flip probe's EXACT 8-bit-equality assertion still valid:
+// not mathematically exact, but exact at every precision this engine's
+// pixel gates (D17's own +-4/255 tolerance included) ever observe.
+import material;
+
+struct UnlitParams {
+    // Universal glTF default [core spec, fetched 2026-08-18]: [1,1,1,1].
+    float4 baseColorFactor;
+
+    // D11 bindless-index convention: ALWAYS a valid, real texture (the
+    // white 1x1 utility texture when the source glTF material has no
+    // baseColorTexture at all) -- no separate "has texture" flag needed,
+    // since sampling white multiplies baseColorFactor by exactly 1.0.
+    uint baseColorTexture;
+
+    // [D28] MASK's cutoff -- a per-instance uniform with an ALWAYS-PRESENT
+    // conditional discard below, per MaterialFixedFunctionState's own
+    // header comment (material_system.h): alphaMode itself lives entirely
+    // in the VkPipeline fixed-function state (D28), never here. Callers
+    // binding an OPAQUE/BLEND instance set this to 0.0 (alpha is never
+    // negative, so a 0.0 cutoff never discards); a MASK instance sets the
+    // glTF-parsed `alphaCutoff` (spec default 0.5).
+    float alphaCutoff;
+
+    // KHR_texture_transform [consume-now per gate ruling C4]: xy = UV
+    // offset, zw = UV scale, applied to `v.uv` before sampling
+    // baseColorTexture. Neutral default (0,0,1,1) reproduces plain
+    // untransformed UV sampling exactly for the (overwhelming majority of)
+    // materials that do not use the extension.
+    float4 baseColorUvOffsetScale;
+};
+
+[[vk::binding(0, 1)]]
+ParameterBlock<UnlitParams> gParams;
+
+struct Unlit : IMaterialShader {
+    float4 evaluate(MaterialVertex v) {
+        float2 uv = v.uv * gParams.baseColorUvOffsetScale.zw + gParams.baseColorUvOffsetScale.xy;
+        float4 color = gParams.baseColorFactor * rx_sampleTexture(gParams.baseColorTexture, uv);
+
+        // [D28] Always-present conditional discard -- see UnlitParams::
+        // alphaCutoff's own comment above.
+        if (color.a < gParams.alphaCutoff) {
+            discard;
+        }
+
+        // See this file's own header comment: every field below is read
+        // through a negligible (1e-6) additive epsilon -- an exact `* 0.0`
+        // does NOT survive Slang's interface-elimination pass for a vertex
+        // interpolant (verified; see that comment for the full mechanism).
+        color.r += v.worldPos.x * 1e-6;
+        color.g += v.normal.x * 1e-6;
+        color.b += v.tangent.x * 1e-6;
+        color.a += v.lightDirWorld.x * 1e-6;
+        color.r += v.lightColor.x * 1e-6;
+        color.g += v.ambientColor.x * 1e-6;
+        color.b += v.cameraPosWorld.x * 1e-6;
+        return color;
+    }
+};
+
+export struct MaterialImpl : IMaterialShader = Unlit;
diff --git a/src/rx_material/include/rx_material/draw_data.h b/src/rx_material/include/rx_material/draw_data.h
new file mode 100644
index 0000000..d559554
--- /dev/null
+++ b/src/rx_material/include/rx_material/draw_data.h
@@ -0,0 +1,136 @@
+#pragma once
+// rx_material/draw_data.h -- D26.1's C++ mirror of the GPU-side per-draw
+// addressing shapes `shaders/material/material.slang` declares (`RxDrawData`,
+// `RxMaterialGlobals`). Thread-affinity: none (plain POD; every field is a
+// value type with no synchronization of its own).
+//
+// WHY THIS HEADER EXISTS (not just duplicated inline where each caller needs
+// it): this project has already been bitten once by exactly this class of
+// duplication drifting out of sync -- see shaders/multipass/scene_types.slang's
+// own header comment ("ObjectTransform used to be declared [in two files]...
+// they drifted"). D26.1 needs the IDENTICAL byte layout known in (at least)
+// three places -- MaterialSystem's own default per-draw buffer
+// (material_system.cpp), samples/08_gltf_viewer's real per-submesh buffer,
+// and rx_material's own D26.1 GPU tests -- so this header is the ONE place
+// that layout is spelled out in C++, matching material.slang's own
+// `RxDrawData`/`RxMaterialGlobals` struct declarations field-for-field.
+// EVERY field ordering/type below must be kept in exact lockstep with
+// material.slang's copy; there is no automated cross-check (Slang structs
+// and C++ structs are two different compilers), so any future edit to
+// EITHER side must edit both, in the same commit, and re-run the D26.1
+// GPU tests (they read pixels rendered FROM this exact byte layout, so a
+// drift shows up as a wrong-pixel failure, not a silent corruption).
+//
+// LAYOUT CONVENTION: RxDrawData is read back via Slang's `StructuredBuffer<T>`
+// (std430-like layout: scalars/vectors pack at their own natural alignment,
+// mat4 is 4 consecutive 16-byte-aligned float4 "rows" -- see the MATRIX
+// LAYOUT paragraph below -- no surprise padding unlike a push-constant
+// block; see rx_rhi_vk's PipelineLayoutBuilder header comment on why THIS
+// project avoids float3/mat4 fields inside a push-constant struct instead,
+// and lit.vert.slang's own header comment for the empirical finding that
+// motivated it).
+//
+// MATRIX LAYOUT -- read before writing any code that populates a
+// DrawDataGpu row: MaterialSystem's own `slang::ISession` is built via a
+// plain, default-constructed `slang::SessionDesc{}` (material_system.cpp's
+// createSession(), verified directly -- no `defaultMatrixLayoutMode`
+// override anywhere in that file), which leaves that field at Slang's own
+// API default -- ROW-major -- EXACTLY the same session-construction shape
+// (and therefore the same matrix-layout default) `rx_shader::Compiler::
+// create()`'s own documented MATRIX LAYOUT paragraph (compiler.h) describes
+// for the identical reason. That default applies uniformly to every
+// `float4x4` a material.slang-importing shader reads from memory, a
+// StructuredBuffer<RxDrawData> element included -- NOT just push-constant
+// blocks. glm::mat4 defaults to COLUMN-major storage (this engine already
+// depends on GLM, `rx_core` links `glm::glm` PUBLIC) -- the OPPOSITE
+// convention. Every writer of `model`/`normalMatrix`/`viewProj` below MUST
+// `glm::transpose()` each matrix immediately before writing its bytes into
+// a real DrawDataGpu row, exactly matching `samples/03_bindless_mesh/
+// main.cpp`'s own `updateTransforms()` precedent (`glm::transpose(viewProj
+// * model)` right before upload) -- skipping this produces a silently
+// garbled (transposed) transform, not a validation error or a crash.
+
+#include <glm/glm.hpp>
+#include <cstdint>
+
+namespace rx::material {
+
+// One row of the bindless per-draw StructuredBuffer StandardPBR/Unlit's
+// vertexMain reads via `gDrawData[gMaterialGlobals.drawDataBufferIndex]
+// [SV_VulkanInstanceID]` [D26.1, gate ruling RC1/#8: SV_VulkanInstanceID, NOT
+// SV_InstanceID -- Slang subtracts firstInstance back out of SV_InstanceID
+// to preserve D3D-compatible semantics, so an ordinary SV_InstanceID read
+// would silently give a per-draw-relative (always-0-on-a-single-draw) index
+// instead of the absolute bindless-buffer row D26.1 requires]. One row per
+// DRAW (one vkCmdDrawIndexed call, addressed by that draw's own
+// `firstInstance` argument), never per hardware-instanced-copy (Phase 4 never
+// issues instanceCount > 1 -- see recordDrawList's own future "instancing
+// collapse" note, D26 point 3, registry).
+//
+// `viewProj`/`lightDirWorld`/`lightColor`/`ambientColor`/`cameraPosWorld`
+// are genuinely PER-PASS (not per-draw) values, redundantly repeated on
+// every row -- the
+// SAME "simpler than a second one-row bindless buffer just for it" precedent
+// shaders/multipass/lit.vert.slang's own header comment already establishes
+// for its own per-pass `lightDirWorld`. This sidesteps needing a SECOND
+// StructuredBuffer<T> binding (Slang/SPIR-V requires one binding per
+// distinct element TYPE, and material.slang already spends its one bindless
+// storage-buffer slot -- BindlessTable::kStorageBufferBinding -- on this
+// exact type) at the cost of a few redundant bytes per draw, which is
+// negligible at Phase 4's per-frame draw counts.
+struct DrawDataGpu {
+    glm::mat4 model{1.0F};         // object -> world.
+    glm::mat4 normalMatrix{1.0F};  // transpose(inverse(mat3(model))), widened to mat4 (upper-left 3x3 used; see
+                                    // this header's own header comment on why mat4 not mat3 -- alignment simplicity).
+    glm::mat4 viewProj{1.0F};      // world -> clip. Per-pass, repeated per row (see this struct's own comment).
+
+    // xyz = unit vector FROM the shaded surface TOWARD the light (i.e. the
+    // negated light-travel direction for a directional light); w unused
+    // (padding -- keeps this a plain float4 for predictable std430 packing,
+    // matching every other vector field in this struct).
+    glm::vec4 lightDirWorld{0.0F, 1.0F, 0.0F, 0.0F};
+    glm::vec4 lightColor{1.0F, 1.0F, 1.0F, 0.0F};    // rgb = color * intensity; w unused.
+    glm::vec4 ambientColor{0.03F, 0.03F, 0.03F, 0.0F};  // [FG1] flat interim ambient/environment term; w unused.
+
+    // [BRDF baseline] World-space camera/eye position, xyz (w unused) --
+    // per-pass, repeated per row like the three fields above. Genuinely
+    // required, not a convenience: Schlick Fresnel/GGX specular need a real
+    // view direction (`normalize(cameraPosWorld - worldPos)`), which cannot
+    // be reconstructed from `worldPos`/`normal` alone -- see
+    // material.slang's own `MaterialVertex::cameraPosWorld` comment.
+    glm::vec4 cameraPosWorld{0.0F, 0.0F, 0.0F, 0.0F};
+
+    // Informational (matches Task 19's future DrawPayload shape, which also
+    // carries a material index alongside the instance/transform index) --
+    // StandardPBR/Unlit's own evaluate() does not read this field in Phase
+    // 4 (a draw's material is already fixed by which VkPipeline/descriptor
+    // set the CPU bound before issuing it); kept so the D26.1 two-draw test
+    // has a second, independently-varying field to assert on beyond the
+    // transform, and so a future GPU-driven consumer sorting/grouping by
+    // material does not need to widen this row's layout to add it.
+    uint32_t materialIndex = 0;
+    uint32_t _pad0 = 0;
+    uint32_t _pad1 = 0;
+    uint32_t _pad2 = 0;
+};
+static_assert(sizeof(DrawDataGpu) == 272, "DrawDataGpu must stay exactly 272 bytes -- mirrors material.slang's RxDrawData");
+
+// Mirrors material.slang's `RxMaterialGlobals` push-constant struct
+// (`[[vk::push_constant]] ConstantBuffer<RxMaterialGlobals> gMaterialGlobals;`)
+// field-for-field. Deliberately ALL-SCALAR (no vec/mat fields) -- see
+// lit.vert.slang's own header comment for the empirically-verified reason
+// this project avoids vector/matrix fields inside a push-constant block
+// (Slang's push-constant packing rules are not the predictable std430 rules
+// a StructuredBuffer gets); every genuinely vector-shaped per-pass value
+// (viewProj, light/ambient) lives in DrawDataGpu above instead, reached
+// indirectly via `drawDataBufferIndex`.
+struct MaterialGlobalsPush {
+    uint32_t defaultSamplerIndex = 0;  // bindless SAMPLER index -- material.slang's pre-D26.1 field, unchanged.
+    uint32_t drawDataBufferIndex = 0;  // bindless STORAGE BUFFER index of the DrawDataGpu[] this draw reads.
+    float exposure = 0.0F;             // pre-tonemap 2^exposure multiplier (0.0 = neutral, no-op: 2^0 == 1).
+};
+static_assert(sizeof(MaterialGlobalsPush) == 12,
+              "MaterialGlobalsPush must stay exactly 12 bytes (3 packed 4-byte scalars) -- mirrors material.slang's "
+              "RxMaterialGlobals, and bindInstance() (material_system.cpp) pushes exactly this many bytes for it");
+
+}  // namespace rx::material
diff --git a/src/rx_material/include/rx_material/material_system.h b/src/rx_material/include/rx_material/material_system.h
index 4586492..cd3e647 100644
--- a/src/rx_material/include/rx_material/material_system.h
+++ b/src/rx_material/include/rx_material/material_system.h
@@ -41,32 +41,81 @@ using PassSignature = rx::graph::PassSignature;
 // Default-constructed handles are invalid (`isValid() == false`); every
 // handle actually returned by loadMaterial() has a real generation.
