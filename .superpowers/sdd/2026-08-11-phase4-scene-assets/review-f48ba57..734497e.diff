+TEST_CASE("StandardPBR: alphaMode=MASK discards below cutoff, renders opaque above it (checker alpha texture)") {
+    auto rig = makeStandardPbrRig("standard_pbr_mask");
+    if (!rig.has_value()) {
+        return;
