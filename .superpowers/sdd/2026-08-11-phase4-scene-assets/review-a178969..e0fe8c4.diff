+    // the BEST -- priority must still dominate.
+    const uint64_t low = encodeOpaque(/*priority=*/0, 0x7F, 0x7FFF, /*ndcDepth=*/0.0F, /*tieBreak=*/0xFFFF);
+    const uint64_t high = encodeOpaque(/*priority=*/7, 0, 0, /*ndcDepth=*/1.0F, /*tieBreak=*/0);
