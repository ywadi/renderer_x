+// renormalized vector's components can transiently exceed [-1,1] by a
+// hair from float rounding).
+uint8_t encodeSignedUnorm(float value) {
+    float scaled = (value * 0.5F + 0.5F) * 255.0F;
+    scaled = std::clamp(scaled, 0.0F, 255.0F);
