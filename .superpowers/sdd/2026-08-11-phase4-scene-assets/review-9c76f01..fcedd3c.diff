+// (tangent-space normal-map convention: byte 0 -> -1.0, byte 255 -> +1.0).
+float decodeSignedUnorm(uint8_t byteValue) { return (static_cast<float>(byteValue) / 255.0F) * 2.0F - 1.0F; }
