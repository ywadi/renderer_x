     RX_ASSERT_MAIN_THREAD("GeometryPool::free");
 
     if (range.blockId >= blocks_.size()) {
         RX_LOG_ERROR("GeometryPool::free: blockId {} is out of range ({} blocks live)", range.blockId,
                      blocks_.size());
         return;
