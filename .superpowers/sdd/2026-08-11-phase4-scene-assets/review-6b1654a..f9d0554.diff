+    graph.addPass("present").addColorOutput("bb", colorDesc());                 // pass 1
+    graph.setBackbufferSource("bb");
+    graph.compile(kInfo);
+
+    const CompiledGraph& compiled = graph.compiled();
+    CHECK_FALSE(compiled.isCulled(0));
