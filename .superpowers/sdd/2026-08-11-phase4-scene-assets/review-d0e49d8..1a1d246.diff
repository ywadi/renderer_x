+        uint32_t count = 0;
+    };
+    // Indexed by static_cast<size_t>(TextureRole) -- 6 entries, one per
+    // TextureRole enumerator (texture_decode.h).
+    std::array<RoleStats, 6> byRole{};
+    uint64_t totalBytes = 0;
+    uint32_t totalCount = 0;
+};
