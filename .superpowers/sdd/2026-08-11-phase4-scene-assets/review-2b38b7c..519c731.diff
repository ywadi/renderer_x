+    constexpr uint32_t kSlotBytes = 256;  // vkCmdFillBuffer requires a multiple of 4; well over that.
+    constexpr VkDeviceSize kBufferBytes = static_cast<VkDeviceSize>(kSlotCount) * kSlotBytes;
