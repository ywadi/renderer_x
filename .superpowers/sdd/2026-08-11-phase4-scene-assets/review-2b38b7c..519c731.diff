+    BufferDesc dataDesc;
+    dataDesc.size = kBufferBytes;
+    dataDesc.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
